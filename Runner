local FOLDER = "RUNLUA_HUB"
Library.Folder = FOLDER

local function fsOk()
    return type(writefile) == "function" and type(readfile) == "function"
       and type(isfolder) == "function" and type(makefolder) == "function"
       and type(isfile) == "function" and type(listfiles) == "function"
end

local function ensureFolder()
    if not isfolder(FOLDER) then makefolder(FOLDER) end
end

function Library:GetConfigs()
    local out = {}
    if not fsOk() then return out end
    pcall(function()
        ensureFolder()
        for _, p in ipairs(listfiles(FOLDER)) do
            local n = tostring(p):match("([^/\\]+)%.json$")
            if n then table.insert(out, n) end
        end
    end)
    table.sort(out)
    return out
end

function Library:SaveConfig(name)
    if not fsOk() then return false, "executor ไม่รองรับ writefile" end
    name = Clean(name)
    if name == "" then return false, "ชื่อ config ว่างอยู่" end
    local data = {}
    for flag, obj in pairs(self.Options) do
        local v = obj:Get()
        if obj.Type == "Color" and v then
            v = { R = math.floor(v.R * 255 + 0.5), G = math.floor(v.G * 255 + 0.5), B = math.floor(v.B * 255 + 0.5) }
        end
        data[flag] = v
    end
    local ok, err = pcall(function()
        ensureFolder()
        writefile(FOLDER .. "/" .. name .. ".json", HttpService:JSONEncode(data))
    end)
    return ok, err
end

function Library:LoadConfig(name)
    if not fsOk() then return false, "executor ไม่รองรับ readfile" end
    name = Clean(name)
    local path = FOLDER .. "/" .. name .. ".json"
    if name == "" or not isfile(path) then return false, "ไม่พบ config" end
    local ok, data = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
    if not ok or type(data) ~= "table" then return false, "ไฟล์ config เสีย" end
    for flag, v in pairs(data) do
        local obj = self.Options[flag]
        if obj then
            pcall(function()
                if obj.Type == "Color" and type(v) == "table" then
                    obj:Set(Color3.fromRGB(v.R or 0, v.G or 0, v.B or 0))
                else
                    obj:Set(v)
                end
            end)
        end
    end
    return true
end

function Library:DeleteConfig(name)
    if not fsOk() then return false end
    name = Clean(name)
    local path = FOLDER .. "/" .. name .. ".json"
    if type(delfile) == "function" and isfile(path) then
        return pcall(delfile, path)
    end
    return false
end

function Library:SetAutoload(name)
    if not fsOk() then return false end
    return pcall(function() ensureFolder(); writefile(FOLDER .. "/autoload.txt", Clean(name)) end)
end

function Library:LoadAutoload()
    if not fsOk() then return false end
    local ok, name = pcall(function()
        if isfile(FOLDER .. "/autoload.txt") then return readfile(FOLDER .. "/autoload.txt") end
    end)
    if ok and name and name ~= "" then
        local done = self:LoadConfig(name)
        if done then Library.Notify("Autoload", "โหลด config: " .. name, 2.5, "Success") end
        return done
    end
    return false
end

function Library:Unload()
    for _, c in ipairs(self.Connections) do pcall(function() c:Disconnect() end) end
    table.clear(self.Connections)
    pcall(function() Root:Destroy() end)
    if _G.RUNLUA_LIB == self then _G.RUNLUA_LIB = nil end
    self.Unloaded = true
end

