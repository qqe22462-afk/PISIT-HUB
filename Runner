            if pMoved <= 8 then Window:Toggle() end
        end
    end)

    -- ปุ่มลัดเปิด/ปิด
    Connect(UIS.InputBegan, function(input, gp)
        if gp or Library._listening then return end
        if Window.ToggleKey and input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == Window.ToggleKey then
            Window:Toggle()
        end
    end)

    -- =====================================================
    -- INTRO
    -- =====================================================
    if cfg.Intro == false then
        Window:SetVisible(true)
    else
        local splash = New("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(280, 150),
            BackgroundColor3 = Theme.Panel, BorderSizePixel = 0, ZIndex = 400,
        }, Root)
        local ssc = New("UIScale", { Scale = 0.8 }, splash)
        Corner(splash, 18); Stroke(splash, "Blue", 1.5, 0.2)
        AddIcon(splash, cfg.Icon or "Run", UDim2.fromOffset(46, 46), UDim2.new(0.5, 0, 0, 40))
        New("TextLabel", {
            Size = UDim2.new(1, 0, 0, 22), Position = UDim2.new(0, 0, 0, 74), BackgroundTransparency = 1, Text = title,
            TextColor3 = Theme.White, Font = Enum.Font.GothamBold, TextSize = 16,
        }, splash)
        local pb = New("Frame", { Size = UDim2.new(1, -60, 0, 4), Position = UDim2.new(0, 30, 1, -30), BackgroundColor3 = Color3.fromRGB(30, 42, 58), BorderSizePixel = 0 }, splash)
        Corner(pb, 4)
        local pfill = New("Frame", { Size = UDim2.fromScale(0, 1), BorderSizePixel = 0 }, pb)
        Bind(pfill, "BackgroundColor3", "BlueBright"); Corner(pfill, 4)
        Tween(ssc, SPRING, { Scale = 1 })
        Tween(pfill, TweenInfo.new(1.2, Enum.EasingStyle.Quart), { Size = UDim2.fromScale(1, 1) })
        task.delay(1.4, function()
            if Library.Unloaded then return end
            local t = Tween(ssc, NORM, { Scale = 0.8 })
            t.Completed:Connect(function() splash:Destroy() end)
            Window:SetVisible(true)
        end)
    end

    Window.Main, Window.Header, Window.Sidebar, Window.ContentArea = Main, Header, TabList, ContentArea
    return Window
end

return Library
