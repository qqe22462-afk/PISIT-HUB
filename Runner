local function SafeImage(img, url)
    if not img or not img.Parent then return end
    pcall(function() img.Image = url end)
end

local function ResolveAssetUrl(cid)
    if not RunService:IsStudio() then return nil end
    local url
    pcall(function()
        local objs = game:GetObjects("rbxassetid://" .. cid)
        if objs and #objs > 0 then
            local o = objs[1]
            if o:IsA("Decal") or o:IsA("Texture") then
                url = o.Texture
            elseif o:IsA("ImageLabel") or o:IsA("ImageButton") then
                url = o.Image
            else
                local d = o:FindFirstChildWhichIsA("Decal", true)
                        or o:FindFirstChildWhichIsA("Texture", true)
                if d then url = d.Texture end
            end
            pcall(function() o:Destroy() end)
        end
    end)
    return url
end

local function FallbackUrl(cid)
    return "rbxthumb://type=Asset&id=" .. cid .. "&w=150&h=150"
end

local IconRegistry = {}

local function RegisterUrl(numId, cid)
    if IconRegistry[numId] then return IconRegistry[numId] end
    local rec = { url = nil, images = {}, loading = true }
    IconRegistry[numId] = rec
    task.spawn(function()
        local url = ResolveAssetUrl(cid)
        if not url or url == "" then url = FallbackUrl(cid) end
        rec.url = url
        rec.loading = false
        for _, img in ipairs(rec.images) do
            SafeImage(img, url)
        end
    end)
    return rec
end

local function RegIcon(imageLabel, id)
    if not imageLabel or not id then return end
    local cid = tostring(id):match("%d+")
    if not cid then return end
    local numId = tonumber(cid) or cid

    SafeImage(imageLabel, FallbackUrl(cid))

    local rec = IconRegistry[numId]
    if not rec then
        rec = RegisterUrl(numId, cid)
    end
    table.insert(rec.images, imageLabel)

    if rec.url and not rec.loading then
        SafeImage(imageLabel, rec.url)
    end
end

local function PreloadAllIcons()
    for _, id in pairs(ICON_IDS) do
        local cid = tostring(id):match("%d+")
        if cid then
            local numId = tonumber(cid) or cid
            if not IconRegistry[numId] then
                RegisterUrl(numId, cid)
            end
        end
    end
end
