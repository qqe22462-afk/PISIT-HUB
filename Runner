            ColorSequenceKeypoint.new(0, Color3.fromRGB(8, 14, 24)),
            ColorSequenceKeypoint.new(0.5, Color3.fromRGB(5, 10, 18)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(3, 6, 12)),
        }),
    }, Main)

