    -- ---------- TOGGLE ----------
    function E:CreateToggle(cfg)
        cfg = cfg or {}
        local state = cfg.Default == true
        local f = RowBase(parent, cfg.Desc and 52 or 43)
        RowHeader(f, cfg, 70)
        local sw = New("Frame", { Size = UDim2.fromOffset(42, 22), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), BackgroundColor3 = Theme.Off }, f)
        Corner(sw, 20)
        local dot = New("Frame", { Size = UDim2.fromOffset(16, 16), AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 3, 0.5, 0), BackgroundColor3 = Theme.White, BorderSizePixel = 0 }, sw)
        Corner(dot, 20)

        local function render(anim)
            local col = state and Theme.Blue or Theme.Off
            local pos = state and UDim2.new(1, -19, 0.5, 0) or UDim2.new(0, 3, 0.5, 0)
            if anim then
                Tween(sw, NORM, { BackgroundColor3 = col })
                Tween(dot, NORM, { Position = pos })
            else
                sw.BackgroundColor3 = col; dot.Position = pos
            end
        end
        render(false)
        Themeable(function() render(false) end)

        local obj = { Type = "Toggle", Frame = f }
        function obj:Get() return state end
        function obj:Set(v, silent)
            state = v == true
            render(true)
            if not silent then Commit(cfg, state) end
        end
        Hit(f).MouseButton1Click:Connect(function() obj:Set(not state) end)
        Register(cfg, obj)
        Reg(f, cfg.Name)
