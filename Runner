    tabBtn.AutoButtonColor = false
    tabBtn.Parent = sidebar
    Instance.new("UICorner", tabBtn).CornerRadius = UDim.new(0, 6)

    local tabStroke = Instance.new("UIStroke")
    tabStroke.Color = Theme.Border
    tabStroke.Thickness = 1
    tabStroke.Transparency = 0.6
    tabStroke.Parent = tabBtn

    local iconHolder = Instance.new("Frame")
    iconHolder.Size = UDim2.fromOffset(16, 16)
    iconHolder.Position = UDim2.new(0, 8, 0.5, -8)
    iconHolder.BackgroundTransparency = 1
    iconHolder.Parent = tabBtn
    iconDraw(iconHolder, Theme.TextMuted)

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -30, 1, 0)
    label.Position = UDim2.new(0, 28, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = tabName
    label.TextColor3 = Theme.TextMuted
    label.Font = Fonts.Medium
    label.TextSize = 11
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextTruncate = Enum.TextTruncate.AtEnd
    label.Parent = tabBtn

    local pageScroll = Instance.new("ScrollingFrame")
    pageScroll.Name = "Page_" .. tabName
    pageScroll.Size = UDim2.new(1, 0, 1, 0)
    pageScroll.BackgroundTransparency = 1
    pageScroll.BorderSizePixel = 0
    pageScroll.ScrollBarThickness = 3
    pageScroll.ScrollBarImageColor3 = Theme.Accent
    pageScroll.CanvasSize = UDim2.new(0, 0, 0, 0)
    pageScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
    pageScroll.Visible = false
    pageScroll.Parent = content

    local pageLayout = Instance.new("UIListLayout")
    pageLayout.SortOrder = Enum.SortOrder.LayoutOrder
    pageLayout.Padding = UDim.new(0, Config.RowSpacing)
    pageLayout.Parent = pageScroll

    local pagePadding = Instance.new("UIPadding")
    pagePadding.PaddingRight = UDim.new(0, 6)
    pagePadding.PaddingLeft = UDim.new(0, 2)
    pagePadding.PaddingTop = UDim.new(0, 2)
    pagePadding.PaddingBottom = UDim.new(0, 6)
    pagePadding.Parent = pageScroll

    local tabData = {
        Btn        = tabBtn,
        Label      = label,
        IconHolder = iconHolder,
        Page       = pageScroll,
    }
    table.insert(Tabs, tabData)

    local function selectTab()
        for _, t in ipairs(Tabs) do
            t.Page.Visible = false
            t.Btn.BackgroundColor3 = Theme.SurfaceAlt
            t.Label.TextColor3 = Theme.TextMuted
            tintIconHolder(t.IconHolder, Theme.TextMuted, false)
        end

        pageScroll.Visible = true
        tabBtn.BackgroundColor3 = Theme.SurfaceHover
        label.TextColor3 = Theme.Text
        tintIconHolder(iconHolder, Theme.Accent, true)
        activeTab = tabData
    end

    track(tabBtn.Activated:Connect(selectTab))

    if #Tabs == 1 then
        selectTab()
    end

    local tabApi = {}

    function tabApi:AddSection(opts)
        return Components.CreateSection(pageScroll, opts)
    end

    function tabApi:AddToggle(opts)
        return Components.CreateToggle(pageScroll, opts)
    end

    function tabApi:AddButton(opts)
        return Components.CreateButton(pageScroll, opts)
    end

    function tabApi:AddSlider(opts)
        return Components.CreateSlider(pageScroll, opts)
    end

    function tabApi:AddInput(opts)
        return Components.CreateInput(pageScroll, opts)
    end

    function tabApi:AddKeybind(opts)
        return Components.CreateKeybind(pageScroll, opts)
    end

    function tabApi:AddDropdown(opts)
        return Components.CreateDropdown(pageScroll, opts)
    end

    function tabApi:AddLabel(opts)
        return Components.CreateLabel(pageScroll, opts)
    end

    function tabApi:AddParagraph(opts)
        return Components.CreateParagraph(pageScroll, opts)
    end

    function tabApi:AddDivider(order)
        return Components.CreateDivider(pageScroll, order)
    end

    function tabApi:AddPlayerList(opts)
        return Components.CreatePlayerList(pageScroll, opts)
    end

    return tabApi
end

