    titleLabel.Parent = row

    local valueLabel = Instance.new("TextLabel")
    valueLabel.BackgroundTransparency = 1
    valueLabel.Position = UDim2.new(1, -76, 0, 5)
    valueLabel.Size = UDim2.new(0, 68, 0, 14)
    valueLabel.Text = displayFormat(default)
    valueLabel.TextColor3 = Theme.AccentLight
    valueLabel.Font = Fonts.Bold
    valueLabel.TextSize = 11
    valueLabel.TextXAlignment = Enum.TextXAlignment.Right
    valueLabel.Parent = row

    local trackBg = Instance.new("Frame")
    trackBg.Name = "Track"
    trackBg.Size = UDim2.new(1, -20, 0, 6)
    trackBg.Position = UDim2.new(0, 10, 1, -13)
    trackBg.BackgroundColor3 = Theme.SwitchOff
    trackBg.BorderSizePixel = 0
    trackBg.Parent = row
    Instance.new("UICorner", trackBg).CornerRadius = UDim.new(1, 0)

    local fill = Instance.new("Frame")
    fill.Name = "Fill"
    fill.Size = UDim2.new(0, 0, 1, 0)
    fill.BackgroundColor3 = Theme.Accent
    fill.BorderSizePixel = 0
    fill.Parent = trackBg
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(10, 10)
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.Position = UDim2.new(1, 0, 0.5, 0)
    knob.BackgroundColor3 = Theme.White
    knob.BorderSizePixel = 0
    knob.Parent = fill
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local clickArea = Instance.new("TextButton")
    clickArea.Size = UDim2.new(1, 0, 0, 22)
    clickArea.Position = UDim2.new(0, 0, 1, -22)
    clickArea.BackgroundTransparency = 1
    clickArea.Text = ""
    clickArea.Parent = row

    local currentValue = math.clamp(default, minVal, maxVal)
    local dragging = false

    local function applyVisual(animate)
        local percent = (currentValue - minVal) / math.max(0.0001, maxVal - minVal)
        local targetSize = UDim2.new(percent, 0, 1, 0)
        if animate then
            TweenService:Create(fill, TweenInfo.new(Config.AnimFast), { Size = targetSize }):Play()
        else
            fill.Size = targetSize
        end
        valueLabel.Text = displayFormat(currentValue)
    end

    local function setValueFromX(absX, fire)
        local trackPos = trackBg.AbsolutePosition.X
        local trackSize = math.max(1, trackBg.AbsoluteSize.X)
        local percent = math.clamp((absX - trackPos) / trackSize, 0, 1)
        local raw = minVal + percent * (maxVal - minVal)
        if step > 0 then
            raw = math.floor(raw / step + 0.5) * step
        end
        currentValue = math.clamp(raw, minVal, maxVal)
        applyVisual(false)
        if fire then pcall(callback, currentValue) end
    end

    applyVisual(false)

    track(clickArea.InputBegan:Connect(function(input)
        local it = input.UserInputType
        if it == Enum.UserInputType.MouseButton1 or it == Enum.UserInputType.Touch then
            dragging = true
            setValueFromX(input.Position.X, true)
        end
    end))

    track(UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        local it = input.UserInputType
        if it == Enum.UserInputType.MouseMovement or it == Enum.UserInputType.Touch then
            setValueFromX(input.Position.X, true)
        end
    end))

    track(UserInputService.InputEnded:Connect(function(input)
        if not dragging then return end
        local it = input.UserInputType
        if it == Enum.UserInputType.MouseButton1 or it == Enum.UserInputType.Touch then
            dragging = false
        end
    end))

    return row, function() return currentValue end, function(v)
        currentValue = math.clamp(tonumber(v) or minVal, minVal, maxVal)
        applyVisual(true)
    end
end

