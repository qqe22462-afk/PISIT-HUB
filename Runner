function Library.Notify(...)
    local a = { ... }
    if a[1] == Library then table.remove(a, 1) end
    local cfg
    if type(a[1]) == "table" then
        cfg = a[1]
    else
        cfg = { Title = a[1], Content = a[2], Duration = a[3], Type = a[4] }
    end
    local typ = "Info"
    local color
    if typeof(cfg.Type) == "Color3" then color = cfg.Type
    elseif type(cfg.Type) == "string" and NotifyTypes[cfg.Type] then typ = cfg.Type end
    local def = NotifyTypes[typ]
    color = color or Theme[def[1]]
    local duration = cfg.Duration or 3

    local wrap = New("Frame", { Size = UDim2.new(1, 0, 0, 66), BackgroundTransparency = 1 }, NotifyHolder)
    local card = New("Frame", {
        Size = UDim2.fromScale(1, 1), Position = UDim2.new(1, 60, 0, 0),
        BackgroundColor3 = Theme.Panel, BackgroundTransparency = 0.05, BorderSizePixel = 0,
    }, wrap)
    Corner(card, 12); Stroke(card, color, 1.2, 0.4)

    New("Frame", { Size = UDim2.new(0, 3, 1, -20), Position = UDim2.new(0, 6, 0, 10), BackgroundColor3 = color, BorderSizePixel = 0 }, card)
    Corner(card:FindFirstChildOfClass("Frame"), 4)

    local ib = New("Frame", { Size = UDim2.fromOffset(32, 32), Position = UDim2.new(0, 18, 0.5, -3), AnchorPoint = Vector2.new(0, 0.5), BackgroundColor3 = color, BackgroundTransparency = 0.8 }, card)
    Corner(ib, 9)
    AddIcon(ib, def[2], UDim2.fromOffset(18, 18))

    New("TextLabel", {
        Size = UDim2.new(1, -66, 0, 18), Position = UDim2.new(0, 58, 0, 8), BackgroundTransparency = 1,
        Text = tostring(cfg.Title or "RUNLUA"), TextColor3 = Theme.White, Font = Enum.Font.GothamBold,
        TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
    }, card)
    New("TextLabel", {
        Size = UDim2.new(1, -66, 0, 24), Position = UDim2.new(0, 58, 0, 26), BackgroundTransparency = 1,
        Text = tostring(cfg.Content or ""), TextColor3 = Theme.Muted, Font = Enum.Font.Gotham,
        TextSize = 10, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
        TextWrapped = true,
    }, card)

    local pbg = New("Frame", { Size = UDim2.new(1, -28, 0, 3), Position = UDim2.new(0, 14, 1, -8), BackgroundColor3 = Color3.fromRGB(30, 42, 58), BorderSizePixel = 0 }, card)
    Corner(pbg, 3)
    local pf = New("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = color, BorderSizePixel = 0 }, pbg)
    Corner(pf, 3)

    Tween(card, NORM, { Position = UDim2.new(0, 0, 0, 0) })
    Tween(pf, TweenInfo.new(duration, Enum.EasingStyle.Linear), { Size = UDim2.new(0, 0, 1, 0) })
    task.delay(duration, function()
        if card and card.Parent then
            local t = Tween(card, NORM, { Position = UDim2.new(1, 60, 0, 0) })
            t.Completed:Connect(function() wrap:Destroy() end)
        end
    end)
    return card
end

