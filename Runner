-- =========================================================
-- HELPERS
-- =========================================================
local function Connect(signal, fn)
    local c = signal:Connect(fn)
    table.insert(Library.Connections, c)
    return c
end

local function safe(fn, ...)
    if type(fn) == "function" then
        local ok, err = pcall(fn, ...)
        if not ok then warn("[RUNLUA] " .. tostring(err)) end
    end
end

local function New(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props or {}) do o[k] = v end
    if parent then o.Parent = parent end
    return o
end

local function Tween(o, info, props)
    local t = TS:Create(o, info, props)
    t:Play()
    return t
end

local function Corner(p, r)
    return New("UICorner", { CornerRadius = UDim.new(0, r or 8) }, p)
end

local function Stroke(p, color, thick, trans)
    local s = New("UIStroke", {
        Thickness = thick or 1, Transparency = trans or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, p)
    if type(color) == "string" then Bind(s, "Color", color) else s.Color = color or Theme.Border end
    return s
end

local function Pad(p, l, t, r, b)
    return New("UIPadding", {
        PaddingLeft = UDim.new(0, l or 0), PaddingTop = UDim.new(0, t or 0),
        PaddingRight = UDim.new(0, r or 0), PaddingBottom = UDim.new(0, b or 0),
    }, p)
end

local function ListLayout(p, pad)
    return New("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, pad or 8) }, p)
end

local function ResolveIcon(v)
    if type(v) == "string" and ICON_IDS[v] then return ICON_IDS[v] end
    return v
end

local function SetIcon(img, id)
    id = ResolveIcon(id)
    local cid = tostring(id or ""):match("%d+")
    if not cid then return end
    img.Image = "rbxassetid://" .. cid
    task.spawn(function()
        pcall(function()
            img.Image = "rbxthumb://type=Asset&id=" .. cid .. "&w=150&h=150"
        end)
    end)
end

local function AddIcon(parent, id, size, pos, anchor)
    local img = New("ImageLabel", {
        Name = "Icon", Size = size or UDim2.fromOffset(20, 20),
        Position = pos or UDim2.new(0.5, 0, 0.5, 0),
        AnchorPoint = anchor or Vector2.new(0.5, 0.5),
        BackgroundTransparency = 1, BorderSizePixel = 0,
        ScaleType = Enum.ScaleType.Fit, ImageColor3 = Color3.new(1, 1, 1),
    }, parent)
    local g = New("UIGradient", { Rotation = -45 }, img)
    Themeable(function(t)
        g.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, t.White),
            ColorSequenceKeypoint.new(1, t.BlueBright),
        })
    end)
    SetIcon(img, id)
    return img
end

local function Mount(gui)
    pcall(function() if syn and syn.protect_gui then syn.protect_gui(gui) end end)
    local ok = false
    if type(gethui) == "function" then ok = pcall(function() gui.Parent = gethui() end) end
    if not ok or not gui.Parent then ok = pcall(function() gui.Parent = CoreGui end) end
    if not ok or not gui.Parent then gui.Parent = LP:WaitForChild("PlayerGui") end
end

