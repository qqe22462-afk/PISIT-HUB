        TweenService:Create(keyBtn, TweenInfo.new(Config.AnimFast), { BackgroundColor3 = Theme.SurfaceAlt }):Play()
        if inputConn then inputConn:Disconnect() inputConn = nil end
    end

    track(keyBtn.Activated:Connect(function()
        if listening then stopListening() return end
        listening = true
        keyBtn.Text = "..."
        TweenService:Create(keyStroke, TweenInfo.new(Config.AnimFast), { Color = Theme.Accent, Transparency = 0 }):Play()
        TweenService:Create(keyBtn, TweenInfo.new(Config.AnimFast), { BackgroundColor3 = Theme.SurfaceHover }):Play()

        inputConn = UserInputService.InputBegan:Connect(function(input, gp)
