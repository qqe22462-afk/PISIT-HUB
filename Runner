    local FitScale = 1
    local function Fit()
        local cam = workspace.CurrentCamera
        local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
        FitScale = math.clamp(math.min(vp.X / 690, vp.Y / 445), 0.5, 1)
        if Window.Visible then Scale.Scale = FitScale end
    end
    Fit()
    if workspace.CurrentCamera then
        Connect(workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"), Fit)
    end

    function Window:SetVisible(v)
        Window.Visible = v
        if v then
            Main.Visible = true
            Scale.Scale = FitScale * 0.9
            Tween(Scale, SPRING, { Scale = FitScale })
        else
            Tween(Scale, FAST, { Scale = FitScale * 0.9 })
            task.delay(0.15, function() if not Window.Visible then Main.Visible = false end end)
        end
    end
