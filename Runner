    -- ---------- KEYBIND ----------
    function E:CreateKeybind(cfg)
        cfg = cfg or {}
        local key = cfg.Default or "None"
        if typeof(key) == "EnumItem" then key = key.Name end
        local listening = false
        local f = RowBase(parent, 43)
        RowHeader(f, cfg, 100)
        local btn = New("TextButton", {
            Size = UDim2.fromOffset(82, 26), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0),
            BackgroundColor3 = Theme.Panel, Text = key, TextColor3 = Theme.BlueBright, TextSize = 11,
            Font = Enum.Font.GothamBold, AutoButtonColor = false,
        }, f)
        Bind(btn, "TextColor3", "BlueBright")
        Corner(btn, 7); Stroke(btn, "Blue", 1, 0.5)

        local obj = { Type = "Keybind", Frame = f }
        function obj:Get() return key end
        function obj:Set(v, silent)
            if typeof(v) == "EnumItem" then v = v.Name end
            key = tostring(v or "None"); btn.Text = key
            if cfg.Flag then Library.Flags[cfg.Flag] = key end
            if not silent then safe(cfg.OnChanged, key) end
        end
        btn.MouseButton1Click:Connect(function()
            listening = true; Library._listening = true; btn.Text = "..."
        end)
        Connect(UIS.InputBegan, function(input, gp)
            if listening then
                if input.UserInputType == Enum.UserInputType.Keyboard then
                    local n = input.KeyCode.Name
                    if n == "Escape" or n == "Backspace" then n = "None" end
                    listening = false
                    task.defer(function() Library._listening = false end)
                    obj:Set(n)
                end
                return
            end
            if gp or key == "None" then return end
            if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode.Name == key then
                safe(cfg.Callback, key)
            end
        end)
        Register(cfg, obj)
        Reg(f, cfg.Name)
        return obj
    end

    -- ---------- COLOR PICKER (HSV + Rainbow) ----------
    function E:CreateColorPicker(cfg)
        cfg = cfg or {}
        local h, s, v = (cfg.Default or Theme.Blue):ToHSV()
        local open, rainbow = false, false

        local f = RowBase(parent, 43)
        RowHeader(f, cfg, 110)
        local prev = New("TextButton", {
            Size = UDim2.fromOffset(44, 24), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0, 21.5),
            BackgroundColor3 = Color3.new(1, 1, 1), Text = "", AutoButtonColor = false,
        }, f)
        Corner(prev, 7); Stroke(prev, Theme.White, 1, 0.5)
        local rgbBtn
        if cfg.Rainbow ~= false then
            rgbBtn = New("TextButton", {
                Size = UDim2.fromOffset(36, 22), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -62, 0, 21.5),
                BackgroundColor3 = Theme.Panel, Text = "RGB", TextColor3 = Theme.Muted, TextSize = 9,
                Font = Enum.Font.GothamBold, AutoButtonColor = false,
            }, f)
            Corner(rgbBtn, 6); Stroke(rgbBtn, Theme.Border, 1, 0.5)
        end

        local sv = New("Frame", { Position = UDim2.new(0, 12, 0, 50), Size = UDim2.new(1, -50, 0, 100), BackgroundColor3 = Color3.new(1, 0, 0), BorderSizePixel = 0 }, f)
        Corner(sv, 8)
        local white = New("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0 }, sv)
        Corner(white, 8)
        New("UIGradient", { Transparency = NumberSequence.new(0, 1) }, white)
        local black = New("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0 }, sv)
        Corner(black, 8)
        New("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(1, 0) }, black)
        local svCur = New("Frame", { Size = UDim2.fromOffset(12, 12), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1 }, sv)
        Corner(svCur, 10); Stroke(svCur, Theme.White, 2, 0)

        local hue = New("Frame", { Position = UDim2.new(1, -30, 0, 50), Size = UDim2.fromOffset(18, 100), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0 }, f)
        Corner(hue, 6)
        local kp = {}
        for i = 0, 6 do kp[#kp + 1] = ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(math.min(i / 6, 0.999), 1, 1)) end
        New("UIGradient", { Rotation = 90, Color = ColorSequence.new(kp) }, hue)
        local hueCur = New("Frame", { Size = UDim2.new(1, 4, 0, 4), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Theme.White, BorderSizePixel = 0 }, hue)
        Corner(hueCur, 3); Stroke(hueCur, Color3.new(0, 0, 0), 1, 0.4)

        local svHit = New("TextButton", { Position = sv.Position, Size = sv.Size, BackgroundTransparency = 1, Text = "", AutoButtonColor = false }, f)
        local hueHit = New("TextButton", { Position = hue.Position, Size = hue.Size, BackgroundTransparency = 1, Text = "", AutoButtonColor = false }, f)

        local obj = { Type = "Color", Frame = f }
        local function color() return Color3.fromHSV(h, s, v) end
        local function refresh(silent)
            prev.BackgroundColor3 = color()
            sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
            svCur.Position = UDim2.new(s, 0, 1 - v, 0)
            hueCur.Position = UDim2.new(0.5, 0, h, 0)
            if not silent then Commit(cfg, color()) end
        end
        function obj:Get() return color() end
        function obj:Set(c, silent) h, s, v = c:ToHSV(); refresh(silent) end
        refresh(true)

        local dragSV, dragH = false, false
        local function updSV(p)
            s = math.clamp((p.X - sv.AbsolutePosition.X) / math.max(sv.AbsoluteSize.X, 1), 0, 1)
            v = 1 - math.clamp((p.Y - sv.AbsolutePosition.Y) / math.max(sv.AbsoluteSize.Y, 1), 0, 1)
            refresh()
        end
        local function updH(p)
            h = math.clamp((p.Y - hue.AbsolutePosition.Y) / math.max(hue.AbsoluteSize.Y, 1), 0, 0.999)
            refresh()
        end
        local function isPress(i) return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch end
        svHit.InputBegan:Connect(function(i) if isPress(i) then dragSV = true; LockScroll(true); updSV(i.Position) end end)
        hueHit.InputBegan:Connect(function(i) if isPress(i) then dragH = true; LockScroll(true); updH(i.Position) end end)
        Connect(UIS.InputChanged, function(i)
            if i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch then
                if dragSV then updSV(i.Position) elseif dragH then updH(i.Position) end
            end
        end)
        Connect(UIS.InputEnded, function(i)
            if isPress(i) and (dragSV or dragH) then dragSV, dragH = false, false; LockScroll(false) end
        end)

        if rgbBtn then
            local rconn
            rgbBtn.MouseButton1Click:Connect(function()
                rainbow = not rainbow
                rgbBtn.TextColor3 = rainbow and Theme.BlueBright or Theme.Muted
                if rainbow and not rconn then
                    rconn = Connect(RunService.RenderStepped, function(dt)
                        if rainbow then h = (h + dt * 0.2) % 1; s = math.max(s, 0.6); v = math.max(v, 0.8); refresh() end
                    end)
                end
            end)
        end

        prev.MouseButton1Click:Connect(function()
            open = not open
            Tween(f, FAST, { Size = UDim2.new(1, 0, 0, open and 162 or 43) })
        end)
        Register(cfg, obj)
        Reg(f, cfg.Name)
        return obj
    end

    return E
end

