function Components.CreateToggle(parent, opts)
    opts = opts or {}
    local title = opts.Name or "สวิตช์"
    local desc = opts.Description
    local default = opts.Default or false
    local callback = opts.Callback or function() end
    local iconDraw = opts.Icon or Icons.Settings
    local rowHeight = desc and Config.RowHeightDesc or Config.RowHeight

    local row = makeRow(parent, "Toggle_" .. title, rowHeight, opts.Order)
    local iconHolder = makeRowIcon(row, iconDraw, desc and 8 or (rowHeight/2 - 8))
    makeRowTitle(row, title, desc, 32)

    local SWITCH_W, SWITCH_H = 34, 18
    local KNOB = 12
    local PAD  = 3

    local switch = Instance.new("Frame")
    switch.Name = "Switch"
    switch.Size = UDim2.fromOffset(SWITCH_W, SWITCH_H)
    switch.Position = UDim2.new(1, -(SWITCH_W + 8), 0.5, -SWITCH_H / 2)
    switch.BackgroundColor3 = Theme.SwitchOff
    switch.BorderSizePixel = 0
    switch.Parent = row
    Instance.new("UICorner", switch).CornerRadius = UDim.new(1, 0)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(KNOB, KNOB)
    knob.Position = UDim2.new(0, PAD, 0.5, -KNOB / 2)
    knob.BackgroundColor3 = Color3.fromRGB(150, 160, 180)
    knob.BorderSizePixel = 0
    knob.Parent = switch
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local OFF_POS = UDim2.new(0, PAD,                   0.5, -KNOB / 2)
    local ON_POS  = UDim2.new(0, SWITCH_W - KNOB - PAD, 0.5, -KNOB / 2)

    local toggleState = default

    local function applyState(animate)
        local targetPos  = toggleState and ON_POS or OFF_POS
        local targetBg   = toggleState and Theme.Accent or Theme.SwitchOff
        local targetKnob = toggleState and Color3.fromRGB(255,255,255) or Color3.fromRGB(150,160,180)

        if animate then
            TweenService:Create(knob, TweenInfo.new(Config.AnimNormal, Enum.EasingStyle.Quad), {
                Position = targetPos, BackgroundColor3 = targetKnob
            }):Play()
            TweenService:Create(switch, TweenInfo.new(Config.AnimNormal, Enum.EasingStyle.Quad), {
                BackgroundColor3 = targetBg
            }):Play()
        else
            knob.Position = targetPos
            knob.BackgroundColor3 = targetKnob
            switch.BackgroundColor3 = targetBg
        end
        tintIconHolder(iconHolder, Theme.TextMuted, toggleState)
    end
    applyState(false)

    local click = Instance.new("TextButton")
    click.Size = UDim2.new(1, 0, 1, 0)
    click.BackgroundTransparency = 1
    click.Text = ""
    click.Parent = row

    attachRowHover(row, click)
    track(click.Activated:Connect(function()
        toggleState = not toggleState
        applyState(true)
        pcall(callback, toggleState)
    end))

    return row, function() return toggleState end, function(v)
        if toggleState ~= v then
            toggleState = v
            applyState(true)
        end
    end
end

