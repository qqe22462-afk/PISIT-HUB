    end

    -- ---------- SLIDER ----------
    function E:CreateSlider(cfg)
        cfg = cfg or {}
        local min, max = cfg.Min or 0, cfg.Max or 100
        local inc = cfg.Increment or 1
        local s = tostring(inc)
        local dotPos = s:find(".", 1, true)
        local dec = dotPos and (#s - dotPos) or 0
        local suffix = cfg.Suffix or ""
        local val = min

        local f = RowBase(parent, 58)
        local nameLbl = RowHeader(f, cfg, 100)
        nameLbl.Size = UDim2.new(1, -(14 + 100) - (cfg.Icon and 26 or 0), 0, 20)
        nameLbl.Position = UDim2.new(0, cfg.Icon and 40 or 14, 0, 6)
        if cfg.Icon then
            f:FindFirstChild("Icon").Position = UDim2.new(0, 12, 0, 7)
        end
        local valLbl = New("TextLabel", {
            Size = UDim2.fromOffset(86, 20), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 6),
            BackgroundTransparency = 1, TextColor3 = Theme.BlueBright, TextSize = 12, Font = Enum.Font.GothamBold,
            TextXAlignment = Enum.TextXAlignment.Right,
        }, f)
        Bind(valLbl, "TextColor3", "BlueBright")

        local track = New("Frame", { Size = UDim2.new(1, -28, 0, 6), Position = UDim2.new(0, 14, 1, -17), BackgroundColor3 = Color3.fromRGB(30, 42, 58), BorderSizePixel = 0 }, f)
        Corner(track, 5)
        local fill = New("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0 }, track)
        Corner(fill, 5)
        local fg = New("UIGradient", {}, fill)
        Themeable(function(t) fg.Color = ColorSequence.new(t.BlueDark, t.BlueBright) end)
        local knob = New("Frame", { Size = UDim2.fromOffset(14, 14), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0.5, 0), BackgroundColor3 = Theme.White, BorderSizePixel = 0 }, track)
        Corner(knob, 20); Stroke(knob, "BlueBright", 2)

        local obj = { Type = "Slider", Frame = f }
        local function apply(v, silent)
            v = math.clamp(math.floor(v / inc + 0.5) * inc, min, max)
            v = tonumber(string.format("%." .. dec .. "f", v))
            val = v
            local rel = (max > min) and (v - min) / (max - min) or 0
            fill.Size = UDim2.new(rel, 0, 1, 0)
            knob.Position = UDim2.new(rel, 0, 0.5, 0)
            valLbl.Text = string.format("%." .. dec .. "f", v) .. suffix
            if not silent then Commit(cfg, v) end
        end
        function obj:Get() return val end
        function obj:Set(v, silent) apply(tonumber(v) or min, silent) end

        apply(cfg.Default or min, true)

        local hit = New("TextButton", { Size = UDim2.new(1, -20, 0, 26), Position = UDim2.new(0, 10, 1, -27), BackgroundTransparency = 1, Text = "", AutoButtonColor = false }, f)
        local dragging = false
        local function fromX(x)
            local rel = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
            apply(min + (max - min) * rel)
        end
        hit.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                dragging = true; LockScroll(true); fromX(i.Position.X)
            end
        end)
        Connect(UIS.InputChanged, function(i)
            if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
                fromX(i.Position.X)
            end
        end)
        Connect(UIS.InputEnded, function(i)
            if dragging and (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) then
                dragging = false; LockScroll(false)
            end
        end)
        Register(cfg, obj)
        Reg(f, cfg.Name)
        return obj
    end

    -- ---------- DROPDOWN (Single / Multi / Search) ----------
    function E:CreateDropdown(cfg)
        cfg = cfg or {}
        local options = cfg.Options or {}
        local multi = cfg.Multi == true
        local searchable = cfg.Search == true or #options > 8
        local extra = searchable and 32 or 0
        local sel
        if multi then
            sel = {}
            if type(cfg.Default) == "table" then for _, v in ipairs(cfg.Default) do sel[tostring(v)] = true end end
        else
            sel = cfg.Default and tostring(cfg.Default) or nil
        end

        local holder = New("Frame", { Size = UDim2.new(1, 0, 0, 43), BackgroundTransparency = 1, ClipsDescendants = true }, parent)
        local f = RowBase(holder, 43)
        RowHeader(f, cfg, 150)
        local valLbl = New("TextLabel", {
            Size = UDim2.new(0, 120, 1, 0), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -30, 0, 0),
            BackgroundTransparency = 1, TextColor3 = Theme.BlueBright, TextSize = 11, Font = Enum.Font.GothamBold,
            TextXAlignment = Enum.TextXAlignment.Right, TextTruncate = Enum.TextTruncate.AtEnd,
        }, f)
        Bind(valLbl, "TextColor3", "BlueBright")
        local arrow = New("TextLabel", {
            Size = UDim2.fromOffset(20, 43), Position = UDim2.new(1, -24, 0, 0), BackgroundTransparency = 1,
            Text = "▼", TextColor3 = Theme.Muted, TextSize = 9, Font = Enum.Font.GothamBold,
        }, f)
        local hit = Hit(f)

        local searchBox
        if searchable then
            local sb = New("Frame", { Position = UDim2.new(0, 0, 0, 47), Size = UDim2.new(1, 0, 0, 28), BackgroundColor3 = Theme.Panel, BackgroundTransparency = 0.1 }, holder)
            Corner(sb, 8); Stroke(sb, Theme.Border, 1, 0.5)
            searchBox = New("TextBox", {
                Size = UDim2.new(1, -16, 1, 0), Position = UDim2.new(0, 10, 0, 0), BackgroundTransparency = 1,
                Text = "", PlaceholderText = "ค้นหา...", PlaceholderColor3 = Theme.Muted, TextColor3 = Theme.Text,
                TextSize = 11, Font = Enum.Font.GothamMedium, TextXAlignment = Enum.TextXAlignment.Left, ClearTextOnFocus = false,
            }, sb)
        end

        local list = New("ScrollingFrame", {
            Position = UDim2.new(0, 0, 0, 47 + extra), Size = UDim2.new(1, 0, 0, 0), BackgroundColor3 = Theme.Panel,
            BackgroundTransparency = 0.05, BorderSizePixel = 0, ScrollBarThickness = 2, Visible = false,
            AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(),
        }, holder)
        Bind(list, "ScrollBarImageColor3", "Blue")
        Corner(list, 10); Stroke(list, "Blue", 1, 0.5); Pad(list, 4, 4, 4, 4); ListLayout(list, 3)

        local isOpen = false
        local buttons = {}
        local obj = { Type = "Dropdown", Frame = holder }

        local function isSel(s) if multi then return sel[s] == true else return sel == s end end
        local function text()
            if multi then
                local t = {}
                for _, o in ipairs(options) do if sel[tostring(o)] then t[#t + 1] = tostring(o) end end
                return #t > 0 and table.concat(t, ", ") or "None"
            end
            return sel or "—"
        end
        local listH = 0
        local function openHeight() return 43 + 4 + extra + listH + 4 end

        local function close()
            isOpen = false
            Tween(holder, FAST, { Size = UDim2.new(1, 0, 0, 43) })
            Tween(arrow, FAST, { Rotation = 0 })
            task.delay(0.16, function() if not isOpen then list.Visible = false end end)
        end

        local function commit()
            local v = obj:Get()
            if cfg.Flag then Library.Flags[cfg.Flag] = v end
            safe(cfg.Callback, v)
        end

        local function Build()
            for _, b in ipairs(buttons) do b:Destroy() end
            buttons = {}
            local q = searchBox and searchBox.Text:lower() or ""
            local count = 0
            for i, o in ipairs(options) do
                local s = tostring(o)
                if q == "" or s:lower():find(q, 1, true) then
                    count = count + 1
                    local on = isSel(s)
                    local b = New("TextButton", {
                        LayoutOrder = i, Size = UDim2.new(1, 0, 0, 26),
                        BackgroundColor3 = on and Theme.PanelHover or Theme.Panel2, BackgroundTransparency = on and 0.1 or 0.4,
                        Text = s, TextColor3 = on and Theme.BlueBright or Theme.Text, TextSize = 11,
                        Font = Enum.Font.GothamMedium, AutoButtonColor = false,
                    }, list)
                    Corner(b, 7)
                    b.MouseEnter:Connect(function() Tween(b, FAST, { BackgroundColor3 = Theme.PanelHover, BackgroundTransparency = 0.1 }) end)
                    b.MouseLeave:Connect(function()
                        local s2 = isSel(s)
                        Tween(b, FAST, { BackgroundColor3 = s2 and Theme.PanelHover or Theme.Panel2, BackgroundTransparency = s2 and 0.1 or 0.4 })
                    end)
                    b.MouseButton1Click:Connect(function()
                        if multi then sel[s] = (not sel[s]) or nil else sel = s end
                        valLbl.Text = text()
                        Build(); commit()
                        if not multi then close() end
                    end)
                    table.insert(buttons, b)
                end
            end
            listH = math.min(count * 29 + 8, 150)
            list.Size = UDim2.new(1, 0, 0, listH)
            if isOpen then holder.Size = UDim2.new(1, 0, 0, openHeight()) end
        end

        function obj:Get()
            if multi then
                local t = {}
                for _, o in ipairs(options) do if sel[tostring(o)] then t[#t + 1] = tostring(o) end end
                return t
            end
            return sel
        end
        function obj:Set(v, silent)
            if multi then
                sel = {}
                if type(v) == "table" then
                    if v[1] ~= nil then for _, x in ipairs(v) do sel[tostring(x)] = true end
                    else for k, on in pairs(v) do if on then sel[tostring(k)] = true end end end
                end
            else
                sel = v ~= nil and tostring(v) or nil
            end
            valLbl.Text = text(); Build()
            if not silent then commit() end
        end
        function obj:Refresh(newOptions)
            options = newOptions or options
            if multi then
                for k in pairs(sel) do
                    local found = false
                    for _, o in ipairs(options) do if tostring(o) == k then found = true end end
                    if not found then sel[k] = nil end
                end
            else
                local found = false
                for _, o in ipairs(options) do if tostring(o) == sel then found = true end end
                if not found then sel = nil end
            end
            valLbl.Text = text(); Build()
        end

        valLbl.Text = text()
        Build()
        if searchBox then searchBox:GetPropertyChangedSignal("Text"):Connect(Build) end

        hit.MouseButton1Click:Connect(function()
            isOpen = not isOpen
            if isOpen then
                list.Visible = true; Build()
                Tween(holder, FAST, { Size = UDim2.new(1, 0, 0, openHeight()) })
                Tween(arrow, FAST, { Rotation = 180 })
            else
                close()
            end
        end)
        Register(cfg, obj)
        Reg(holder, cfg.Name)
        return obj
    end

