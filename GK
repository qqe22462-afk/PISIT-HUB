                local listening = false

                Btn.MouseButton1Click:Connect(function()
                    listening = not listening
                    Btn.Text = listening and "..." or key.Name
                    if listening then
                        TS:Create(Btn, FAST, { BackgroundColor3 = THEME.PanelHover }):Play()
                    else
                        TS:Create(Btn, FAST, { BackgroundColor3 = THEME.Panel }):Play()
                    end
