            -- SLIDER
            function SectionAPI:CreateSlider(cfgS)
                cfgS = cfgS or {}
                local min  = cfgS.Min or 0
                local max  = cfgS.Max or 100
                local val  = math.clamp(cfgS.Default or min, min, max)
                local dec  = cfgS.Decimals or 0

                local Row = New("Frame", {
                    Size = UDim2.new(1, -12, 0, 44),
                    BackgroundColor3 = THEME.Panel2,
                    BorderSizePixel = 0,
                }, Container)
                AddCorner(Row, 8)
                local RowStroke = AddStroke(Row, THEME.Border, 1)

                local Label = New("TextLabel", {
                    Size = UDim2.new(1, -90, 0, 18),
                    Position = UDim2.new(0, 12, 0, 3),
                    BackgroundTransparency = 1,
                    Text = cfgS.Name or "Slider",
                    Font = Enum.Font.GothamMedium,
                    TextSize = 12,
                    TextColor3 = THEME.Text,
                    TextXAlignment = Enum.TextXAlignment.Left,
                }, Row)

                local ValueLabel = New("TextLabel", {
                    Size = UDim2.new(0, 70, 0, 18),
                    Position = UDim2.new(1, -80, 0, 3),
                    BackgroundTransparency = 1,
                    Text = tostring(val),
                    Font = Enum.Font.GothamBold,
                    TextSize = 12,
                    TextColor3 = THEME.BlueBright,
                    TextXAlignment = Enum.TextXAlignment.Right,
                }, Row)

                local Track = New("Frame", {
                    Size = UDim2.new(1, -24, 0, 6),
                    Position = UDim2.new(0, 12, 0, 28),
                    BackgroundColor3 = THEME.Panel,
                    BorderSizePixel = 0,
                }, Row)
                AddCorner(Track, 3)

                local Fill = New("Frame", {
                    Size = UDim2.new((val - min) / (max - min), 0, 1, 0),
                    BackgroundColor3 = THEME.Blue,
                    BorderSizePixel = 0,
                }, Track)
                AddCorner(Fill, 3)
                local FillGrad = AddGradient(Fill, 0, THEME.Blue, THEME.BlueBright)

                local Knob = New("Frame", {
                    AnchorPoint = Vector2.new(0.5, 0.5),
                    Size = UDim2.fromOffset(14, 14),
                    Position = UDim2.new((val - min) / (max - min), 0, 0.5, 0),
                    BackgroundColor3 = THEME.White,
                    BorderSizePixel = 0,
                    ZIndex = 2,
                }, Track)
                AddCorner(Knob, 7)
                AddStroke(Knob, THEME.Blue, 2)

                Row.MouseEnter:Connect(function()
                    TS:Create(Row, FAST, { BackgroundColor3 = THEME.PanelHover }):Play()
                    TS:Create(RowStroke, FAST, { Color = THEME.Blue }):Play()
                end)
                Row.MouseLeave:Connect(function()
                    TS:Create(Row, FAST, { BackgroundColor3 = THEME.Panel2 }):Play()
                    TS:Create(RowStroke, FAST, { Color = THEME.Border }):Play()
                end)

                local dragging = false

                local function updateFromX(x)
                    local trackAbs = Track.AbsolutePosition.X
                    local trackW   = Track.AbsoluteSize.X
                    local alpha = math.clamp((x - trackAbs) / trackW, 0, 1)
                    val = min + (max - min) * alpha
                    if dec == 0 then
                        val = math.floor(val + 0.5)
                    else
                        val = tonumber(string.format("%." .. dec .. "f", val))
                    end
                    ValueLabel.Text = tostring(val)
                    local a = (val - min) / (max - min)
                    Fill.Size = UDim2.new(a, 0, 1, 0)
                    Knob.Position = UDim2.new(a, 0, 0.5, 0)
                    if cfgS.Callback then
                        task.spawn(cfgS.Callback, val)
                    end
                end

                Track.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                        or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = true
                        updateFromX(input.Position.X)
                    end
                end)
                UIS.InputChanged:Connect(function(input)
                    if dragging then
                        if input.UserInputType == Enum.UserInputType.MouseMovement
                            or input.UserInputType == Enum.UserInputType.Touch then
                            updateFromX(input.Position.X)
                        end
                    end
                end)
                UIS.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                        or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = false
                    end
                end)

                return {
                    Set = function(v)
                        val = math.clamp(v, min, max)
                        ValueLabel.Text = tostring(val)
                        local a = (val - min) / (max - min)
                        Fill.Size = UDim2.new(a, 0, 1, 0)
                        Knob.Position = UDim2.new(a, 0, 0.5, 0)
                    end,
                    Get = function() return val end,
                }
            end

