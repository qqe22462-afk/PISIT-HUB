            --============================================
            -- SLIDER
            --============================================
            function API:CreateSlider(cfgS)
                cfgS = cfgS or {}
                local min  = cfgS.Min or 0
                local max  = cfgS.Max or 100
                local val  = math.clamp(cfgS.Default or min, min, max)
                local dec  = cfgS.Decimals or 0

                local Row = New("Frame", {
                    Size = UDim2.new(1, 0, 0, 40),
                    BackgroundColor3 = THEME.Panel3,
                    BackgroundTransparency = TRANSPARENCY,
                    BorderSizePixel = 0,
                }, Container)
                AddCorner(Row, 4)
                local RowStroke = AddStroke(Row, THEME.Border, 1)

                local Lbl = New("TextLabel", {
                    Size = UDim2.new(1, -90, 0, 16),
                    Position = UDim2.new(0, 10, 0, 2),
                    BackgroundTransparency = 1,
                    Text = cfgS.Name or "Slider",
                    Font = Enum.Font.GothamBold,
                    TextSize = 10,
                    TextColor3 = THEME.White,
                    TextXAlignment = Enum.TextXAlignment.Left,
                }, Row)

                local Val = New("TextLabel", {
                    Size = UDim2.new(0, 70, 0, 16),
                    Position = UDim2.new(1, -80, 0, 2),
                    BackgroundTransparency = 1,
                    Text = tostring(val),
                    Font = Enum.Font.GothamBold,
                    TextSize = 10,
                    TextColor3 = THEME.BlueBright,
                    TextXAlignment = Enum.TextXAlignment.Right,
                }, Row)

                local Track = New("Frame", {
                    Size = UDim2.new(1, -20, 0, 6),
                    Position = UDim2.new(0, 10, 0, 26),
                    BackgroundColor3 = THEME.Panel,
                    BorderSizePixel = 0,
                }, Row)
                AddCorner(Track, 3)

                local Fill = New("Frame", {
                    Size = UDim2.new((val - min) / (max - min), 0, 1, 0),
                    BackgroundColor3 = THEME.Blue,
                    BorderSizePixel = 0,
                }, Track)
                AddCorner(Fill, 3)
                AddGradient(Fill, 0, THEME.Blue, THEME.BlueBright)

                local Knob = New("Frame", {
                    AnchorPoint = Vector2.new(0.5, 0.5),
                    Size = UDim2.fromOffset(12, 12),
                    Position = UDim2.new((val - min) / (max - min), 0, 0.5, 0),
                    BackgroundColor3 = THEME.White,
                    BorderSizePixel = 0,
                    ZIndex = 2,
                }, Track)
                AddCorner(Knob, 6)
                AddStroke(Knob, THEME.Blue, 2)

                Row.MouseEnter:Connect(function()
                    TS:Create(Row, FAST, { BackgroundColor3 = THEME.Hover }):Play()
                    TS:Create(RowStroke, FAST, { Color = THEME.Blue }):Play()
                end)
                Row.MouseLeave:Connect(function()
                    TS:Create(Row, FAST, { BackgroundColor3 = THEME.Panel3 }):Play()
                    TS:Create(RowStroke, FAST, { Color = THEME.Border }):Play()
                end)

                local dragging = false
                local function updateFromX(x)
                    local a = math.clamp((x - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
                    val = min + (max - min) * a
                    if dec == 0 then
                        val = math.floor(val + 0.5)
                    else
                        val = tonumber(string.format("%." .. dec .. "f", val))
                    end
                    Val.Text = tostring(val)
                    local a2 = (val - min) / (max - min)
                    Fill.Size = UDim2.new(a2, 0, 1, 0)
                    Knob.Position = UDim2.new(a2, 0, 0.5, 0)
                    if cfgS.Callback then task.spawn(cfgS.Callback, val) end
                end

                Track.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                        or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = true
                        updateFromX(input.Position.X)
                    end
                end)
                UIS.InputChanged:Connect(function(input)
                    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
                        or input.UserInputType == Enum.UserInputType.Touch) then
                        updateFromX(input.Position.X)
                    end
                end)
                UIS.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                        or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = false
                    end
                end)

                return {
                    Set = function(v)
                        val = math.clamp(v, min, max)
                        Val.Text = tostring(val)
                        local a2 = (val - min) / (max - min)
                        Fill.Size = UDim2.new(a2, 0, 1, 0)
                        Knob.Position = UDim2.new(a2, 0, 0.5, 0)
                    end,
                    Get = function() return val end,
                }
            end

