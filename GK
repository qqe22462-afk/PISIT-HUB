                        sliders[i].Value = a
                        local r = math.floor(sliders[1].Value * 255)
                        local g = math.floor(sliders[2].Value * 255)
                        local b = math.floor(sliders[3].Value * 255)
                        color = Color3.fromRGB(r, g, b)
                        Swatch.BackgroundColor3 = color
                        if cfgC.Callback then task.spawn(cfgC.Callback, color) end
                    end

                    Track.InputBegan:Connect(function(inp)
                        if inp.UserInputType == Enum.UserInputType.MouseButton1
                            or inp.UserInputType == Enum.UserInputType.Touch then
                            dragging = true
                            update(inp.Position.X)
                        end
                    end)
                    UIS.InputChanged:Connect(function(inp)
                        if dragging and (inp.UserInputType == Enum.UserInputType.MouseMovement
                            or inp.UserInputType == Enum.UserInputType.Touch) then
                            update(inp.Position.X)
                        end
                    end)
                    UIS.InputEnded:Connect(function(inp)
                        if inp.UserInputType == Enum.UserInputType.MouseButton1
                            or inp.UserInputType == Enum.UserInputType.Touch then
                            dragging = false
                        end
                    end)
                end

                local open = false
                Swatch.MouseButton1Click:Connect(function()
                    open = not open
                    Picker.Visible = open
                end)

                return {
                    Set = function(c)
                        color = c
                        Swatch.BackgroundColor3 = c
                        sliders[1].Value = c.R; sliders[1].Fill.Size = UDim2.new(c.R, 0, 1, 0)
                        sliders[2].Value = c.G; sliders[2].Fill.Size = UDim2.new(c.G, 0, 1, 0)
                        sliders[3].Value = c.B; sliders[3].Fill.Size = UDim2.new(c.B, 0, 1, 0)
                    end,
                    Get = function() return color end,
                }
            end

            return API
        end

        return Tab
    end

    --========================================================
    -- SHOW AFTER LOADING
    --========================================================
    task.delay(0.9, function()
        if LoadFrame and LoadFrame.Parent then
            TS:Create(LoadFrame, NORM, { BackgroundTransparency = 1 }):Play()
            TS:Create(LoadStroke, NORM, { Transparency = 1 }):Play()
            TS:Create(LoadText, NORM, { TextTransparency = 1 }):Play()
            TS:Create(LoadIcon, NORM, { ImageTransparency = 1 }):Play()
            TS:Create(LoadBarBg, NORM, { BackgroundTransparency = 1 }):Play()
            TS:Create(LoadBarFill, NORM, { BackgroundTransparency = 1 }):Play()
            task.wait(0.3)
            pcall(function() LoadFrame:Destroy() end)
        end

        Main.Visible = true
        MainScale.Scale = 0.85
        TS:Create(MainScale, SPRING, { Scale = 1 }):Play()
        TogglePill.Visible = true

        Library:Notify({
            Title = "GK HUB",
            Text  = "UI Library v" .. Library.Version .. " loaded",
            Duration = 3,
            Color = THEME.Green,
            Icon = ICON_IDS.Correct,
        })
    end)

    return Window
end

Library.ICON_IDS       = ICON_IDS
Library.ResolveAssetUrl = ResolveAssetUrl
Library.FallbackUrl    = FallbackUrl

return Library
