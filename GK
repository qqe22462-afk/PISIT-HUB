                buildOptions()

                return {
                    Refresh = function(newOpts)
                        options = newOpts
                        buildOptions()
                    end,
                    Set = function(v)
                        selected = v
                        Btn.Text = "▾  " .. tostring(v)
                    end,
                    Get = function() return selected end,
