            -- COLOR PICKER
            function SectionAPI:CreateColorPicker(cfgC)
                cfgC = cfgC or {}
                local color = cfgC.Default or THEME.Blue

                local Row = Row(cfgC.Name or "Color", 60)

                local Swatch = New("TextButton", {
                    Size = UDim2.new(0, 44, 0, 22),
                    Position = UDim2.new(1, -52, 0.5, -11),
                    BackgroundColor3 = color,
                    AutoButtonColor = false,
                    Text = "",
                }, Row)
                AddCorner(Swatch, 6)
                AddStroke(Swatch, THEME.White, 1, 0.6)

                local Picker = New("Frame", {
                    Size = UDim2.new(1, -12, 0, 100),
                    BackgroundColor3 = THEME.Panel,
                    BorderSizePixel = 0,
                    Visible = false,
                }, Container)
                AddCorner(Picker, 8)
                AddStroke(Picker, THEME.Border, 1)

                local Rows = {
                    {Name = "R", Color = Color3.fromRGB(255,80,80)},
                    {Name = "G", Color = Color3.fromRGB(80,255,120)},
                    {Name = "B", Color = Color3.fromRGB(80,140,255)},
                }
                local r, g, b = color.R, color.G, color.B
                local sliders = {}

                for i, info in ipairs(Rows) do
                    local LB = New("TextLabel", {
                        Size = UDim2.new(0, 16, 0, 16),
                        Position = UDim2.new(0, 10, 0, 8 + (i - 1) * 28),
                        BackgroundTransparency = 1,
                        Text = info.Name,
                        Font = Enum.Font.GothamBold,
                        TextSize = 11,
                        TextColor3 = info.Color,
                    }, Picker)

                    local Track = New("Frame", {
                        Size = UDim2.new(1, -40, 0, 6),
                        Position = UDim2.new(0, 30, 0, 13 + (i - 1) * 28),
                        BackgroundColor3 = THEME.Panel2,
                        BorderSizePixel = 0,
                    }, Picker)
                    AddCorner(Track, 3)

                    local Fill = New("Frame", {
                        Size = UDim2.new(0.5, 0, 1, 0),
                        BackgroundColor3 = info.Color,
                        BorderSizePixel = 0,
                    }, Track)
                    AddCorner(Fill, 3)

                    sliders[i] = {Track = Track, Fill = Fill, Value = 0.5}

                    local dragging = false
                    local function update(x)
                        local a = math.clamp((x - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
                        Fill.Size = UDim2.new(a, 0, 1, 0)
                        sliders[i].Value = a
                        local rr = math.floor(sliders[1].Value * 255)
                        local gg = math.floor(sliders[2].Value * 255)
                        local bb = math.floor(sliders[3].Value * 255)
                        color = Color3.fromRGB(rr, gg, bb)
                        Swatch.BackgroundColor3 = color
                        if cfgC.Callback then task.spawn(cfgC.Callback, color) end
                    end

                    Track.InputBegan:Connect(function(inp)
                        if inp.UserInputType == Enum.UserInputType.MouseButton1
                            or inp.UserInputType == Enum.UserInputType.Touch then
                            dragging = true
                            update(inp.Position.X)
                        end
                    end)
                    UIS.InputChanged:Connect(function(inp)
                        if dragging and (inp.UserInputType == Enum.UserInputType.MouseMovement
                            or inp.UserInputType == Enum.UserInputType.Touch) then
                            update(inp.Position.X)
                        end
                    end)
                    UIS.InputEnded:Connect(function(inp)
                        if inp.UserInputType == Enum.UserInputType.MouseButton1
                            or inp.UserInputType == Enum.UserInputType.Touch then
                            dragging = false
                        end
                    end)
                end

                -- init slider positions
                sliders[1].Value = color.R
                sliders[2].Value = color.G
                sliders[3].Value = color.B
                sliders[1].Fill.Size = UDim2.new(color.R, 0, 1, 0)
                sliders[2].Fill.Size = UDim2.new(color.G, 0, 1, 0)
                sliders[3].Fill.Size = UDim2.new(color.B, 0, 1, 0)

                local open = false
                Swatch.MouseButton1Click:Connect(function()
                    open = not open
                    Picker.Visible = open
                end)

                return {
                    Set = function(c)
                        color = c
                        Swatch.BackgroundColor3 = c
                        sliders[1].Value = c.R; sliders[1].Fill.Size = UDim2.new(c.R, 0, 1, 0)
                        sliders[2].Value = c.G; sliders[2].Fill.Size = UDim2.new(c.G, 0, 1, 0)
                        sliders[3].Value = c.B; sliders[3].Fill.Size = UDim2.new(c.B, 0, 1, 0)
                    end,
                    Get = function() return color end,
                }
            end

