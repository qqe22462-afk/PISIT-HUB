                    TS:Create(RowStroke, FAST, { Color = THEME.Border }):Play()
                end)

                local open = false
                Btn.MouseButton1Click:Connect(function()
                    open = not open
                    List.Visible = open
                    Btn.Text = (open and "▴  " or "▾  ") .. tostring(selected)
                end)

