local OPTION_H = 30
local function collapse()
expanded = false
TweenService:Create(listFrame, TweenInfo.new(Config.AnimFast), { Size = UDim2.new(1, 0, 0, 0) }):Play()
task.delay(Config.AnimFast + 0.02, function()
if not expanded and listFrame and listFrame.Parent then
listFrame.Visible = false
end
end)
end
local function expand()
expanded = true
listFrame.Visible = true
local targetH = 12 + #options * (OPTION_H + 3)
TweenService:Create(listFrame, TweenInfo.new(Config.AnimFast), { Size = UDim2.new(1, 0, 0, targetH) }):Play()
