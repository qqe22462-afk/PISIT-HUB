resizeGlyph.TextXAlignment = Enum.TextXAlignment.Center
resizeGlyph.TextYAlignment = Enum.TextYAlignment.Center
resizeGlyph.TextColor3 = Theme.White
resizeGlyph.Font = Enum.Font.GothamBold
resizeGlyph.TextSize = 21
resizeGlyph.ZIndex = 101
resizeGlyph.Parent = resizeHandle
local resizing, resizeInput, resizeStart, resizeStartSize = false, nil, nil, nil
local function finishResize()
resizing, resizeInput, resizeStart, resizeStartSize = false, nil, nil, nil
if computeScale and uiScale then
uiScale.Scale = math.clamp(computeScale(), 0.55, 1.8)
end
end
track(resizeHandle.InputBegan:Connect(function(input)
local kind = input.UserInputType
if kind == Enum.UserInputType.MouseButton1 or kind == Enum.UserInputType.Touch then
resizing = true
resizeInput = input
resizeStart = Vector2.new(input.Position.X, input.Position.Y)
resizeStartSize = Vector2.new(mainFrame.AbsoluteSize.X / math.max(uiScale.Scale, 0.01), mainFrame.AbsoluteSize.Y / math.max(uiScale.Scale, 0.01))
end
end))
track(UserInputService.InputChanged:Connect(function(input)
if not resizing then return end
local kind = input.UserInputType
if kind ~= Enum.UserInputType.MouseMovement and kind ~= Enum.UserInputType.Touch then return end
if resizeInput and resizeInput.UserInputType == Enum.UserInputType.Touch and kind == Enum.UserInputType.Touch and input ~= resizeInput then return end
local pos = Vector2.new(input.Position.X, input.Position.Y)
local delta = pos - resizeStart
delta = Vector2.new(delta.X, delta.Y)
local vp = getViewport()
local scale = math.max(uiScale.Scale, 0.01)
local minW, minH = Config.WindowMinSize.X, Config.WindowMinSize.Y
local maxW, maxH = math.max(minW, (vp.X - 24) / scale), math.max(minH, (vp.Y - 24) / scale)
local w = math.clamp(resizeStartSize.X + delta.X / scale, minW, maxW)
local h = math.clamp(resizeStartSize.Y + delta.Y / scale, minH, maxH)
Config.WindowSize = Vector2.new(math.floor(w + 0.5), math.floor(h + 0.5))
mainFrame.Size = UDim2.fromOffset(Config.WindowSize.X, Config.WindowSize.Y)
mainConstraint.MinSize = Vector2.new(minW, minH)
end))
track(UserInputService.InputEnded:Connect(function(input)
if not resizing then return end
if input == resizeInput or input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
finishResize()
end
end))
track(resizeHandle.MouseEnter:Connect(function()
TweenService:Create(resizeHandle, TweenInfo.new(Config.AnimFast), {BackgroundTransparency = 0}):Play()
end))
track(resizeHandle.MouseLeave:Connect(function()
TweenService:Create(resizeHandle, TweenInfo.new(Config.AnimFast), {BackgroundTransparency = 0.12}):Play()
end))
local layoutState = { compact = false }
local profileCard, profileAvatar, profileName, profileUsername, profileHealthText, profileHealthTrack, profileHealthFill
computeScale = function()
local vp = getViewport()
local inset = getSafeInset()
local availX = math.max(1, vp.X - inset.X - 24)
local availY = math.max(1, vp.Y - inset.Y - 24)
local scaleX = availX / Config.WindowSize.X
local scaleY = availY / Config.WindowSize.Y
local s = math.min(1, math.min(scaleX, scaleY))
return math.clamp(s, 0.55, 1.8)
end
local function keepGuiOnScreen(gui, margin)
if not gui or not gui.Parent then return end
margin = margin or 8
local vp = getViewport()
local size = gui.AbsoluteSize
local anchor = gui.AnchorPoint
local minX = size.X * anchor.X + margin
local maxX = math.max(minX, vp.X - size.X * (1 - anchor.X) - margin)
local minY = size.Y * anchor.Y + margin
local maxY = math.max(minY, vp.Y - size.Y * (1 - anchor.Y) - margin)
local p = gui.AbsolutePosition
local L4Hr1lhr = math.clamp(p.X + size.X * anchor.X, minX, maxX)
local oJobOEao = math.clamp(p.Y + size.Y * anchor.Y, minY, maxY)
gui.Position = UDim2.fromOffset(L4Hr1lhr, oJobOEao)
end
local Tabs = {}
local sidebar, content
local function updateResponsive()
if not sidebar or not content then return end
local vp = getViewport()
local compact = vp.X < Config.CompactBreakpoint
layoutState.compact = compact
local desiredSidebar = compact and Config.SidebarWidthCompact or Config.SidebarWidth
sidebar.Size = UDim2.new(0, desiredSidebar, 1, -(Config.HeaderHeight + 12))
sidebar.Position = UDim2.new(0, 10, 0, Config.HeaderHeight + 6)
sidebar.CanvasPosition = Vector2.new(0, math.max(0, sidebar.CanvasPosition.Y))
local contentLeft = desiredSidebar + 20
content.Size = UDim2.new(1, -(contentLeft + 10), 1, -(Config.HeaderHeight + 14))
content.Position = UDim2.new(0, contentLeft, 0, Config.HeaderHeight + 6)
if uiScale then uiScale.Scale = math.clamp(computeScale(), 0.55, 1.8) end
if profileCard and profileCard.Parent then
profileCard.Visible = true
if compact then
profileCard.Size = UDim2.new(1, 0, 0, 52)
if profileAvatar then
profileAvatar.Size = UDim2.fromOffset(34, 34)
profileAvatar.Position = UDim2.new(0.5, -17, 0.5, -17)
end
if profileName then profileName.Visible = false end
if profileUsername then profileUsername.Visible = false end
if profileHealthText then profileHealthText.Visible = false end
if profileHealthTrack then profileHealthTrack.Visible = false end
else
profileCard.Size = UDim2.new(1, 0, 0, 100)
if profileAvatar then
profileAvatar.Size = UDim2.fromOffset(42, 42)
profileAvatar.Position = UDim2.fromOffset(10, 10)
end
if profileName then profileName.Visible = true end
if profileUsername then profileUsername.Visible = true end
if profileHealthText then profileHealthText.Visible = true end
if profileHealthTrack then profileHealthTrack.Visible = true end
end
end
for _, t in ipairs(Tabs or {}) do
if t and t.Label and t.Label.Parent then
t.Label.Visible = not compact
end
if t and t.IconHolder then
t.IconHolder.Position = compact
and UDim2.new(0.5, -9, 0.5, -9)
or  UDim2.new(0, 12, 0.5, -9)
end
end
if mainFrame and mainFrame.Visible then
local pos = mainFrame.AbsolutePosition
local size = mainFrame.AbsoluteSize
local centerX = pos.X + size.X / 2
local centerY = pos.Y + size.Y / 2
if math.abs(centerX - vp.X / 2) > 2 or math.abs(centerY - vp.Y / 2) > 2 then
mainFrame.AnchorPoint = Vector2.new(0.5, 0.5)
mainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
end
end
if TogglePill and TogglePill.Parent then keepGuiOnScreen(TogglePill, 8) end
end
