title.BackgroundTransparency = 1
title.Text = data.Title or loadstring(base64decode("4LmB4LiI4LmJ4LiH4LmA4LiV4Li34Lit4LiZ"))()
title.TextColor3 = Theme.Text
setTextSize(title, 12)
applyFont(title, Fonts.Bold)
