local function resetPillDrag()
pill.dragging      = false
pill.activeInput   = nil
pill.dragMode      = nil
pill.dragStart     = nil
pill.startPos      = nil
pill.startAbsPos   = Vector2.new(0, 0)
pill.movedDistance = 0
end
local function isPointInPill(pos)
local ap = TogglePill.AbsolutePosition
local as = TogglePill.AbsoluteSize
return pos.X >= ap.X and pos.X <= (ap.X + as.X)
and pos.Y >= ap.Y and pos.Y <= (ap.Y + as.Y)
end
pillToggleWindow = function()
local now = os.clock()
if now - pill.lastToggle < Config.ToggleDebounce then return end
pill.lastToggle = now
if mainFrame.Visible then hideWindow() else showWindow() end
end
track(UserInputService.InputBegan:Connect(function(input)
if not TogglePill.Visible then return end
if pill.dragging then return end
local isTouch      = input.UserInputType == Enum.UserInputType.Touch
local isMouseLeft  = input.UserInputType == Enum.UserInputType.MouseButton1
local isMouseRight = input.UserInputType == Enum.UserInputType.MouseButton2
if not (isTouch or isMouseLeft or isMouseRight) then return end
local pos = Vector2.new(input.Position.X, input.Position.Y)
if not isPointInPill(pos) then return end
if isMouseRight then return end
pill.dragging      = true
pill.activeInput   = input
pill.dragMode      = isTouch and loadstring(base64decode("dG91Y2g="))() or loadstring(base64decode("bW91c2U="))()
pill.dragStart     = input.Position
pill.startPos      = TogglePill.Position
pill.startAbsPos   = pos
pill.movedDistance = 0
TweenService:Create(TogglePill, TweenInfo.new(0.1), {
Size = UDim2.fromOffset(pillSizeMin, pillSizeMin)
}):Play()
end))
track(UserInputService.InputChanged:Connect(function(input)
if not pill.dragging then return end
local it = input.UserInputType
local valid = (pill.dragMode == loadstring(base64decode("dG91Y2g="))() and it == Enum.UserInputType.Touch)
or (pill.dragMode == loadstring(base64decode("bW91c2U="))() and it == Enum.UserInputType.MouseMovement)
if not valid then return end
local currentPos = Vector2.new(input.Position.X, input.Position.Y)
local deltaMove = (currentPos - pill.startAbsPos).Magnitude
if deltaMove > pill.movedDistance then pill.movedDistance = deltaMove end
local vp = getViewport()
local inset = getSafeInset()
local startX = pill.startPos.X.Scale * vp.X + pill.startPos.X.Offset
local startY = pill.startPos.Y.Scale * vp.Y + pill.startPos.Y.Offset
local delta = input.Position - pill.dragStart
local newX, newY = startX + delta.X, startY + delta.Y
local half = TogglePill.AbsoluteSize.X / 2
newX = math.clamp(newX, half, vp.X - half)
newY = math.clamp(newY, inset.Y + half, vp.Y - half)
TogglePill.Position = UDim2.new(0, newX, 0, newY)
end))
track(UserInputService.InputEnded:Connect(function(input)
if not pill.dragging then return end
local it = input.UserInputType
local valid = (pill.dragMode == loadstring(base64decode("dG91Y2g="))() and input == pill.activeInput and it == Enum.UserInputType.Touch)
or (pill.dragMode == loadstring(base64decode("bW91c2U="))() and it == Enum.UserInputType.MouseButton1)
if not valid then return end
local wasTouch = pill.dragMode == loadstring(base64decode("dG91Y2g="))()
local dragged  = pill.movedDistance > Config.DragThreshold
TweenService:Create(TogglePill, TweenInfo.new(0.15, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
Size = UDim2.fromOffset(pillSize, pillSize)
}):Play()
resetPillDrag()
if not dragged and not pillClickGuard then
pillClickGuard = true
pcall(function() if pillToggleWindow then pillToggleWindow() end end)
task.delay(Config.ToggleDebounce, function() pillClickGuard = false end)
end
end))
