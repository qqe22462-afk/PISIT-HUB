local function updateLocalPlayerProfile()
local character = LocalPlayer.Character
local humanoid = character and character:FindFirstChildOfClass(loadstring(base64decode("SHVtYW5vaWQ="))())
if not humanoid or not profileCard or not profileCard.Parent then return end
local maxHealth = math.max(humanoid.MaxHealth, 1)
local health = math.clamp(humanoid.Health, 0, maxHealth)
local ratio = math.clamp(health / maxHealth, 0, 1)
profileHealthText.Text = string.format(loadstring(base64decode("4LmA4Lil4Li34Lit4LiUICAlZCAvICVk"))(), math.floor(health + 0.5), math.floor(maxHealth + 0.5))
profileHealthFill.Size = UDim2.new(ratio, 0, 1, 0)
profileHealthFill.BackgroundColor3 = ratio > 0.5 and Theme.Success or (ratio > 0.2 and Theme.Warning or Theme.Danger)
end
local profileHealthConn
local function hookLocalPlayerHealth(character)
if profileHealthConn then
pcall(function() profileHealthConn:Disconnect() end)
profileHealthConn = nil
end
local humanoid = nil
if character then
humanoid = character:FindFirstChildOfClass(loadstring(base64decode("SHVtYW5vaWQ="))())
if not humanoid then
pcall(function() humanoid = character:WaitForChild(loadstring(base64decode("SHVtYW5vaWQ="))(), 5) end)
end
end
if humanoid then
profileHealthConn = humanoid.HealthChanged:Connect(updateLocalPlayerProfile)
track(profileHealthConn)
updateLocalPlayerProfile()
end
end
track(LocalPlayer.CharacterAdded:Connect(function(character)
task.defer(function() hookLocalPlayerHealth(character) end)
end))
if LocalPlayer.Character then
task.defer(function() hookLocalPlayerHealth(LocalPlayer.Character) end)
end
