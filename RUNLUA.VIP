local function colorsEqual(a, b)
return typeof(a) == loadstring(base64decode("Q29sb3Iz"))() and typeof(b) == loadstring(base64decode("Q29sb3Iz"))()
and math.abs(a.R - b.R) < 0.001
and math.abs(a.G - b.G) < 0.001
and math.abs(a.B - b.B) < 0.001
end
local function paletteRoleColor(role)
if role == loadstring(base64decode("QmFja2dyb3VuZA=="))() then return Theme.Background
elseif role == loadstring(base64decode("U3VyZmFjZQ=="))() then return Theme.Surface
elseif role == loadstring(base64decode("U3VyZmFjZUFsdA=="))() then return Theme.SurfaceAlt
