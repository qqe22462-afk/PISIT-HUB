title.Parent = card
local sub = Instance.new(loadstring(base64decode("VGV4dExhYmVs"))())
sub.Size = UDim2.new(1, -40, 0, 16)
sub.Position = UDim2.new(0, 36, 0, 28)
sub.BackgroundTransparency = 1
sub.Text = data.Message or loadstring(base64decode(""))()
sub.TextColor3 = Theme.TextMuted
setTextSize(sub, 10)
applyFont(sub, Fonts.Regular)
sub.TextXAlignment = Enum.TextXAlignment.Left
