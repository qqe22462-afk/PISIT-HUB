local notifQueue, notifRunning, activeNotifs = {}, false, 0
local function processNotifQueue()
if notifRunning then return end
notifRunning = true
task.spawn(function()
while #notifQueue > 0 and state.uiAlive and screenGui.Parent do
local data = table.remove(notifQueue, 1)
if activeNotifs >= Config.MaxNotifications then
local frames = {}
for _, c in ipairs(notifContainer:GetChildren()) do
if c:IsA(loadstring(base64decode("RnJhbWU="))()) then table.insert(frames, c) end
end
if #frames > 0 then
frames[1]:Destroy()
activeNotifs = math.max(0, activeNotifs - 1)
end
end
