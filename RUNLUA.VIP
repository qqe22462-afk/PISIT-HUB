bindThemeObject(btn, opts.IsSettings and loadstring(base64decode("U2V0dGluZ3NCdXR0b24="))() or loadstring(base64decode("VGFiQnV0dG9u"))())
btn:SetAttribute(loadstring(base64decode("UlVOTFVBX1NFTEVDVEVE"))(), false)
btn:SetAttribute(loadstring(base64decode("UlVOTFVBX0lTX1NFVFRJTkdT"))(), opts.IsSettings == true)
btn.Text = loadstring(base64decode(""))()
btn.AutoButtonColor = false
btn.LayoutOrder = opts.Order or thisIndex
btn.Parent = sidebar
Instance.new(loadstring(base64decode("VUlDb3JuZXI="))(), btn).CornerRadius = UDim.new(0, 6)
local indicator = Instance.new(loadstring(base64decode("RnJhbWU="))())
indicator.Name = loadstring(base64decode("SW5kaWNhdG9y"))()
indicator.Size = UDim2.new(0, 3, 0.5, 0)
indicator.Position = UDim2.new(0, 0, 0.25, 0)
indicator.BackgroundColor3 = Theme.AccentLight
indicator.BorderSizePixel = 0
indicator.BackgroundTransparency = 1
indicator.Parent = btn
Instance.new(loadstring(base64decode("VUlDb3JuZXI="))(), indicator).CornerRadius = UDim.new(1, 0)
local iconHolder = Instance.new(loadstring(base64decode("RnJhbWU="))())
iconHolder.Size = UDim2.fromOffset(18, 18)
iconHolder.Position = UDim2.new(0, 12, 0.5, -9)
iconHolder.BackgroundTransparency = 1
iconHolder.Parent = btn
iconDraw(iconHolder, Theme.TextMuted)
local label = Instance.new(loadstring(base64decode("VGV4dExhYmVs"))())
label.BackgroundTransparency = 1
label.Position = UDim2.new(0, 38, 0, 0)
label.Size = UDim2.new(1, -44, 1, 0)
label.Text = name
label.TextColor3 = Theme.TextMuted
bindThemeProperty(label, loadstring(base64decode("VGV4dE11dGVk"))(), loadstring(base64decode("VGV4dENvbG9yMw=="))())
setTextSize(label, 12)
applyFont(label, Fonts.Medium)
label.TextXAlignment = Enum.TextXAlignment.Left
label.TextTruncate = Enum.TextTruncate.AtEnd
label.Parent = btn
local tab = {
Name = name, Index = thisIndex, Page = page,
Button = btn, Indicator = indicator, Label = label, IconHolder = iconHolder,
IsSettings = opts.IsSettings == true,
}
if tab.IsSettings then
local sep = Instance.new(loadstring(base64decode("RnJhbWU="))())
sep.Name = loadstring(base64decode("U2V0dGluZ3NTZXBhcmF0b3I="))()
sep.Size = UDim2.new(1, 0, 0, 8)
sep.BackgroundTransparency = 1
sep.LayoutOrder = 999998
sep.Parent = sidebar
local line = Instance.new(loadstring(base64decode("RnJhbWU="))())
line.Size = UDim2.new(1, -10, 0, 1)
line.Position = UDim2.new(0, 5, 0.5, 0)
