elseif role == loadstring(base64decode("QWNjZW50U29mdA=="))() then return Theme.AccentSoft
elseif role == loadstring(base64decode("VGV4dA=="))() then return Theme.Text
elseif role == loadstring(base64decode("VGV4dE11dGVk"))() then return Theme.TextMuted
elseif role == loadstring(base64decode("Qm9yZGVy"))() then return Theme.Border
elseif role == loadstring(base64decode("U3VjY2Vzcw=="))() then return Theme.Success
elseif role == loadstring(base64decode("RGFuZ2Vy"))() then return Theme.Danger
elseif role == loadstring(base64decode("V2FybmluZw=="))() then return Theme.Warning
elseif role == loadstring(base64decode("U3dpdGNoT2Zm"))() then return Theme.SwitchOff
elseif role == loadstring(base64decode("V2hpdGU="))() then return Theme.White
elseif role == loadstring(base64decode("SWNvbkRpbQ=="))() then return Theme.IconDim
elseif role == loadstring(base64decode("VG9nZ2xlU3RhdGU="))() then return Theme.Accent
elseif role == loadstring(base64decode("VGFiQnV0dG9u"))() then return Theme.Accent
elseif role == loadstring(base64decode("U2V0dGluZ3NCdXR0b24="))() then return Theme.AccentSoft
end
return nil
end
local function remapPaletteColor(c)
if typeof(c) ~= loadstring(base64decode("Q29sb3Iz"))() then return c end
for key, oldColor in pairs(PreviousTheme) do
if typeof(oldColor) == loadstring(base64decode("Q29sb3Iz"))() and colorsEqual(c, oldColor) then
local newColor = Theme[key]
if typeof(newColor) == loadstring(base64decode("Q29sb3Iz"))() then return newColor end
end
end
return c
end
local function applyThemeBindings()
if screenGui and screenGui.Parent then
for _, obj in ipairs(screenGui:GetDescendants()) do
if obj:IsA(loadstring(base64decode("R3VpT2JqZWN0"))()) then
pcall(function() obj.BackgroundColor3 = remapPaletteColor(obj.BackgroundColor3) end)
pcall(function() obj.TextColor3 = remapPaletteColor(obj.TextColor3) end)
elseif obj:IsA(loadstring(base64decode("VUlTdHJva2U="))()) then
pcall(function() obj.Color = remapPaletteColor(obj.Color) end)
elseif obj:IsA(loadstring(base64decode("VUlHcmFkaWVudA=="))()) then
pcall(function()
local keys = obj.Color.Keypoints
local changed = false
local out = {}
for ke0VXC17, keypoint in ipairs(keys) do
local nc = remapPaletteColor(keypoint.Value)
if nc ~= keypoint.Value then changed = true end
out[ke0VXC17] = ColorSequenceKeypoint.new(keypoint.Time, nc)
end
if changed then obj.Color = ColorSequence.new(out) end
end)
end
end
end
for obj, role in pairs(ThemeObjects) do
if obj and obj.Parent then
local c = paletteRoleColor(role)
if role == loadstring(base64decode("VG9nZ2xlU3RhdGU="))() then
local isOn = false
pcall(function() isOn = obj:GetAttribute(loadstring(base64decode("UlVOTFVBX1RPR0dMRV9TVEFURQ=="))()) == true end)
c = isOn and Theme.Accent or Theme.SwitchOff
elseif role == loadstring(base64decode("VGFiQnV0dG9u"))() then
local selected = false
pcall(function() selected = obj:GetAttribute(loadstring(base64decode("UlVOTFVBX1NFTEVDVEVE"))()) == true end)
c = selected and Theme.Accent or Theme.SurfaceAlt
end
if c then
local binding = ThemeBindings[obj]
local prop = binding and binding.Property
if prop then pcall(function() obj[prop] = c end)
elseif obj:IsA(loadstring(base64decode("R3VpT2JqZWN0"))()) then pcall(function() obj.BackgroundColor3 = c end) end
end
end
end
for k, v in pairs(Theme) do PreviousTheme[k] = v end
