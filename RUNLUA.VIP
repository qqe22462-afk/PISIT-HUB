local function makeRowTitle(row, title, desc, leftPad)
leftPad = leftPad or 42
local titleLabel = Instance.new(loadstring(base64decode("VGV4dExhYmVs"))())
titleLabel.BackgroundTransparency = 1
titleLabel.Text = title
titleLabel.TextColor3 = Theme.Text
bindThemeProperty(titleLabel, loadstring(base64decode("VGV4dA=="))(), loadstring(base64decode("VGV4dENvbG9yMw=="))())
applyFont(titleLabel, Fonts.Medium)
setTextSize(titleLabel, 13)
titleLabel.TextXAlignment = Enum.TextXAlignment.Left
titleLabel.TextTruncate = Enum.TextTruncate.AtEnd
titleLabel.TextYAlignment = Enum.TextYAlignment.Center
titleLabel.Parent = row
local u1 = Instance.new(loadstring(base64decode("VUlUZXh0U2l6ZUNvbnN0cmFpbnQ="))())
u1.MaxTextSize = math.clamp(15 * (UserTextScale or 1), 13, 30)
u1.Parent = titleLabel
if desc then
titleLabel.Position = UDim2.new(0, leftPad, 0, 10)
titleLabel.Size = UDim2.new(1, -(leftPad + 90), 0, 20)
local descLabel = Instance.new(loadstring(base64decode("VGV4dExhYmVs"))())
descLabel.BackgroundTransparency = 1
descLabel.Position = UDim2.new(0, leftPad, 0, 36)
descLabel.Size = UDim2.new(1, -(leftPad + 90), 0, 18)
descLabel.Text = desc
descLabel.TextColor3 = Theme.TextMuted
bindThemeProperty(descLabel, loadstring(base64decode("VGV4dE11dGVk"))(), loadstring(base64decode("VGV4dENvbG9yMw=="))())
applyFont(descLabel, Fonts.Regular)
setTextSize(descLabel, 11)
descLabel.TextXAlignment = Enum.TextXAlignment.Left
descLabel.TextTruncate = Enum.TextTruncate.AtEnd
descLabel.TextYAlignment = Enum.TextYAlignment.Top
descLabel.Parent = row
local u2 = Instance.new(loadstring(base64decode("VUlUZXh0U2l6ZUNvbnN0cmFpbnQ="))())
u2.MaxTextSize = math.clamp(13 * (UserTextScale or 1), 11, 22)
u2.Parent = descLabel
else
titleLabel.Position = UDim2.new(0, leftPad, 0, 0)
titleLabel.Size = UDim2.new(1, -(leftPad + 70), 1, 0)
end
return titleLabel
end
local function attachRowHover(row, btn)
track(btn.MouseEnter:Connect(function()
if not IS_MOBILE then
TweenService:Create(row, TweenInfo.new(Config.AnimFast), { BackgroundColor3 = Theme.SurfaceHover }):Play()
end
end))
track(btn.MouseLeave:Connect(function()
if not IS_MOBILE then
TweenService:Create(row, TweenInfo.new(Config.AnimFast), { BackgroundColor3 = Theme.Surface }):Play()
end
end))
end
function Components.CreateToggle(parent, opts)
opts = opts or {}
local title    = opts.Name or loadstring(base64decode("4Liq4Lin4Li04LiV4LiK4LmM"))()
local desc     = opts.Description
local default  = (type(opts.Default) == loadstring(base64decode("Ym9vbGVhbg=="))()) and opts.Default or false
local callback = opts.Callback or function() end
local iconDraw = opts.Icon or Icons.Settings
local rowHeight = desc and Config.RowHeightDesc or Config.RowHeight
local row = makeRow(parent, loadstring(base64decode("VG9nZ2xlXw=="))() .. title, rowHeight, opts.Order)
local iconHolder = makeRowIcon(row, iconDraw, desc and 12 or (rowHeight / 2 - 10))
makeRowTitle(row, title, desc, 42)
local SWITCH_W, SWITCH_H = 38, 20
local KNOB, PAD = 14, 3
local switch = Instance.new(loadstring(base64decode("RnJhbWU="))())
switch.Name = loadstring(base64decode("U3dpdGNo"))()
switch.Size = UDim2.fromOffset(SWITCH_W, SWITCH_H)
switch.Position = UDim2.new(1, -(SWITCH_W + 12), 0.5, -SWITCH_H / 2)
switch.BackgroundColor3 = Theme.SwitchOff
bindThemeObject(switch, loadstring(base64decode("VG9nZ2xlU3RhdGU="))())
switch.BorderSizePixel = 0
switch.Parent = row
Instance.new(loadstring(base64decode("VUlDb3JuZXI="))(), switch).CornerRadius = UDim.new(1, 0)
local knob = Instance.new(loadstring(base64decode("RnJhbWU="))())
knob.Size = UDim2.fromOffset(KNOB, KNOB)
knob.Position = UDim2.new(0, PAD, 0.5, -KNOB / 2)
knob.BackgroundColor3 = Color3.fromRGB(150, 160, 180)
knob.BorderSizePixel = 0
knob.Parent = switch
Instance.new(loadstring(base64decode("VUlDb3JuZXI="))(), knob).CornerRadius = UDim.new(1, 0)
local OFF_POS = UDim2.new(0, PAD, 0.5, -KNOB / 2)
local ON_POS  = UDim2.new(0, SWITCH_W - KNOB - PAD, 0.5, -KNOB / 2)
local toggleState = default
local floatingSwitch, floatingKnob, floatingLabel
local floatingPanel, floatingModeButton
local function applyState(animate)
local targetPos  = toggleState and ON_POS or OFF_POS
local targetBg   = toggleState and Theme.Accent or Theme.SwitchOff
switch:SetAttribute(loadstring(base64decode("UlVOTFVBX1RPR0dMRV9TVEFURQ=="))(), toggleState)
local targetKnob = toggleState and Color3.fromRGB(255,255,255) or Color3.fromRGB(150,160,180)
if animate then
TweenService:Create(knob, TweenInfo.new(Config.AnimNormal, Enum.EasingStyle.Quad), {
Position = targetPos, BackgroundColor3 = targetKnob
}):Play()
TweenService:Create(switch, TweenInfo.new(Config.AnimNormal, Enum.EasingStyle.Quad), {
BackgroundColor3 = targetBg
}):Play()
else
knob.Position = targetPos
knob.BackgroundColor3 = targetKnob
switch.BackgroundColor3 = targetBg
end
tintIconHolder(iconHolder, Theme.TextMuted, toggleState)
if floatingSwitch and floatingSwitch.Parent then
floatingSwitch.BackgroundColor3 = toggleState and Theme.Accent or Theme.SwitchOff
floatingKnob.Position = toggleState and UDim2.new(1, -18, 0.5, -7) or UDim2.new(0, 4, 0.5, -7)
floatingLabel.Text = toggleState and loadstring(base64decode("4LmA4Lib4Li04LiU"))() or loadstring(base64decode("4Lib4Li04LiU"))()
floatingLabel.TextColor3 = toggleState and Theme.AccentLight or Theme.TextMuted
end
if floatingModeButton and floatingModeButton.Parent and floatingPanel then
local visible = floatingPanel.Visible
floatingModeButton.Text = visible and loadstring(base64decode("4Lil4Lit4Lii4pyT"))() or loadstring(base64decode("4Lil4Lit4Lii"))()
floatingModeButton.BackgroundColor3 = visible and Theme.Accent or Theme.SwitchOff
floatingModeButton.TextColor3 = visible and Theme.White or Theme.TextMuted
end
end
applyState(false)
local click = Instance.new(loadstring(base64decode("VGV4dEJ1dHRvbg=="))())
click.Size = UDim2.new(1, 0, 1, 0)
click.BackgroundTransparency = 1
click.Text = loadstring(base64decode(""))()
click.ZIndex = 1
click.Parent = row
attachRowHover(row, click)
track(click.Activated:Connect(function()
toggleState = not toggleState
applyState(true)
pcall(callback, toggleState)
end))
if opts.Floating == true or opts.FloatButton == true then
floatingModeButton = Instance.new(loadstring(base64decode("VGV4dEJ1dHRvbg=="))())
floatingModeButton.Name = loadstring(base64decode("RmxvYXRpbmdNb2RlQnV0dG9u"))()
floatingModeButton.Size = UDim2.fromOffset(48, 26)
floatingModeButton.Position = UDim2.new(1, -(SWITCH_W + 68), 0.5, -13)
floatingModeButton.BackgroundColor3 = Theme.SwitchOff
floatingModeButton.TextColor3 = Theme.TextMuted
floatingModeButton.Text = loadstring(base64decode("4Lil4Lit4Lii"))()
floatingModeButton.TextSize = 11
floatingModeButton.Font = Enum.Font.GothamBold
floatingModeButton.AutoButtonColor = false
floatingModeButton.ZIndex = 3
floatingModeButton.Parent = row
Instance.new(loadstring(base64decode("VUlDb3JuZXI="))(), floatingModeButton).CornerRadius = UDim.new(0, 5)
floatingPanel = Instance.new(loadstring(base64decode("RnJhbWU="))())
local panel = floatingPanel
panel.Name = loadstring(base64decode("RmxvYXRpbmdUb2dnbGVf"))() .. tostring(title)
panel.Size = UDim2.fromOffset(250, 76)
panel.AnchorPoint = Vector2.new(0.5, 0.5)
panel.Position = UDim2.fromScale(0.5, 0.5)
panel.BackgroundColor3 = Theme.Background
panel.BorderSizePixel = 0
panel.ZIndex = 150
panel.Visible = false
panel.Parent = screenGui
Instance.new(loadstring(base64decode("VUlDb3JuZXI="))(), panel).CornerRadius = UDim.new(0, 10)
local outline = Instance.new(loadstring(base64decode("VUlTdHJva2U="))(), panel)
outline.Color = Theme.Accent
outline.Transparency = 0.18
outline.Thickness = 1.4
local top = Instance.new(loadstring(base64decode("VGV4dEJ1dHRvbg=="))())
top.Name = loadstring(base64decode("RHJhZ0hlYWRlcg=="))()
top.Size = UDim2.new(1, -16, 0, 28)
top.Position = UDim2.fromOffset(8, 6)
top.BackgroundTransparency = 1
top.Text = tostring(title)
top.TextColor3 = Theme.Text
top.TextSize = 14
top.Font = Enum.Font.GothamSemibold
top.TextXAlignment = Enum.TextXAlignment.Left
top.TextTruncate = Enum.TextTruncate.AtEnd
top.ZIndex = 151
top.Parent = panel
floatingLabel = Instance.new(loadstring(base64decode("VGV4dExhYmVs"))())
floatingLabel.Name = loadstring(base64decode("U3RhdGVMYWJlbA=="))()
floatingLabel.BackgroundTransparency = 1
floatingLabel.Position = UDim2.new(0, 10, 0, 40)
floatingLabel.Size = UDim2.new(1, -110, 0, 22)
floatingLabel.Text = loadstring(base64decode("4Lib4Li04LiU"))()
floatingLabel.TextColor3 = Theme.TextMuted
floatingLabel.TextSize = 13
floatingLabel.Font = Enum.Font.Gotham
floatingLabel.TextXAlignment = Enum.TextXAlignment.Left
floatingLabel.ZIndex = 151
floatingLabel.Parent = panel
floatingSwitch = Instance.new(loadstring(base64decode("RnJhbWU="))())
floatingSwitch.Name = loadstring(base64decode("U3dpdGNo"))()
floatingSwitch.Size = UDim2.fromOffset(46, 24)
floatingSwitch.Position = UDim2.new(1, -56, 0, 39)
floatingSwitch.BackgroundColor3 = Theme.SwitchOff
floatingSwitch.BorderSizePixel = 0
floatingSwitch.ZIndex = 151
floatingSwitch.Parent = panel
Instance.new(loadstring(base64decode("VUlDb3JuZXI="))(), floatingSwitch).CornerRadius = UDim.new(1, 0)
floatingKnob = Instance.new(loadstring(base64decode("RnJhbWU="))())
floatingKnob.Size = UDim2.fromOffset(16, 16)
floatingKnob.Position = UDim2.new(0, 4, 0.5, -8)
floatingKnob.BackgroundColor3 = Theme.White
floatingKnob.BorderSizePixel = 0
floatingKnob.ZIndex = 152
floatingKnob.Parent = floatingSwitch
Instance.new(loadstring(base64decode("VUlDb3JuZXI="))(), floatingKnob).CornerRadius = UDim.new(1, 0)
local floatClick = Instance.new(loadstring(base64decode("VGV4dEJ1dHRvbg=="))())
floatClick.Name = loadstring(base64decode("VG9nZ2xlQnV0dG9u"))()
floatClick.Size = UDim2.new(1, 0, 1, 0)
floatClick.BackgroundTransparency = 1
floatClick.Text = loadstring(base64decode(""))()
floatClick.ZIndex = 153
floatClick.Parent = floatingSwitch
track(floatClick.Activated:Connect(function()
toggleState = not toggleState
applyState(true)
pcall(callback, toggleState)
end))
local dragStart, panelStart, dragInput
track(top.InputBegan:Connect(function(input)
if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
dragInput = input
dragStart = Vector2.new(input.Position.X, input.Position.Y)
panelStart = panel.Position
end
end))
track(UserInputService.InputChanged:Connect(function(input)
if not dragInput then return end
local valid = (dragInput.UserInputType == Enum.UserInputType.Touch and input == dragInput)
or (dragInput.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseMovement)
if not valid then return end
local delta = Vector2.new(input.Position.X, input.Position.Y) - dragStart
local vp = getViewport()
local size = panel.AbsoluteSize
local halfW, halfH = size.X / 2, size.Y / 2
local startX = panelStart.X.Scale * vp.X + panelStart.X.Offset
local startY = panelStart.Y.Scale * vp.Y + panelStart.Y.Offset
local L4Hr1lhr = math.clamp(startX + delta.X, halfW + 8, math.max(halfW + 8, vp.X - halfW - 8))
local oJobOEao = math.clamp(startY + delta.Y, halfH + 8, math.max(halfH + 8, vp.Y - halfH - 8))
panel.Position = UDim2.fromOffset(L4Hr1lhr, oJobOEao)
end))
track(UserInputService.InputEnded:Connect(function(input)
if dragInput and (input == dragInput or input.UserInputType == Enum.UserInputType.MouseButton1) then dragInput = nil end
end))
local resize = Instance.new(loadstring(base64decode("VGV4dEJ1dHRvbg=="))())
resize.Name = loadstring(base64decode("UmVzaXplQm90dG9tUmlnaHQ="))()
resize.AnchorPoint = Vector2.new(1, 1)
resize.Position = UDim2.new(1, -4, 1, -4)
resize.Size = UDim2.fromOffset(20, 20)
resize.BackgroundColor3 = Theme.Accent
resize.BackgroundTransparency = 0.1
resize.Text = loadstring(base64decode("4pei"))()
resize.TextColor3 = Theme.White
resize.TextSize = 12
resize.BorderSizePixel = 0
resize.ZIndex = 154
resize.Parent = panel
Instance.new(loadstring(base64decode("VUlDb3JuZXI="))(), resize).CornerRadius = UDim.new(0, 4)
local resizing, resizeStartPos, resizeStartSize, resizeStartPanelPos, resizeInput = false, nil, nil, nil, nil
track(resize.InputBegan:Connect(function(input)
if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
resizing, resizeInput = true, input
resizeStartPos = Vector2.new(input.Position.X, input.Position.Y)
resizeStartSize = panel.AbsoluteSize
resizeStartPanelPos = panel.Position
end
end))
track(UserInputService.InputChanged:Connect(function(input)
if not resizing then return end
local valid = (resizeInput.UserInputType == Enum.UserInputType.Touch and input == resizeInput)
or (resizeInput.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseMovement)
if not valid then return end
local delta = Vector2.new(input.Position.X, input.Position.Y) - resizeStartPos
local w = math.clamp(resizeStartSize.X + delta.X, 200, 440)
local h = math.clamp(resizeStartSize.Y + delta.Y, 66, 150)
panel.Size = UDim2.fromOffset(w, h)
panel.Position = resizeStartPanelPos
end))
track(UserInputService.InputEnded:Connect(function(input)
if resizing and (input == resizeInput or input.UserInputType == Enum.UserInputType.MouseButton1) then
resizing, resizeInput = false, nil
end
end))
track(floatingModeButton.Activated:Connect(function()
panel.Visible = not panel.Visible
floatingModeButton.Text = panel.Visible and loadstring(base64decode("4Lil4Lit4Lii4pyT"))() or loadstring(base64decode("4Lil4Lit4Lii"))()
floatingModeButton.BackgroundColor3 = panel.Visible and Theme.Accent or Theme.SwitchOff
floatingModeButton.TextColor3 = panel.Visible and Theme.White or Theme.TextMuted
end))
applyState(false)
end
return row, function() return toggleState end, function(v)
if toggleState ~= v then
toggleState = v
applyState(true)
end
end
end
function Components.CreateButton(parent, opts)
opts = opts or {}
local title    = opts.Name or loadstring(base64decode("4Lib4Li44LmI4Lih"))()
local desc     = opts.Description
local callback = opts.Callback or function() end
local color    = opts.Color or Theme.Accent
local iconDraw = opts.Icon or Icons.Action
local rowHeight = desc and Config.RowHeightDesc or Config.RowHeight
local row = makeRow(parent, loadstring(base64decode("QnV0dG9uXw=="))() .. title, rowHeight, opts.Order)
makeRowIcon(row, iconDraw, desc and 12 or (rowHeight / 2 - 10), color)
local accent = Instance.new(loadstring(base64decode("RnJhbWU="))())
accent.Size = UDim2.new(0, 3, 0.6, 0)
accent.Position = UDim2.new(0, 0, 0.2, 0)
accent.BackgroundColor3 = color
accent.BorderSizePixel = 0
accent.Parent = row
Instance.new(loadstring(base64decode("VUlDb3JuZXI="))(), accent).CornerRadius = UDim.new(1, 0)
local titleLabel = Instance.new(loadstring(base64decode("VGV4dExhYmVs"))())
titleLabel.BackgroundTransparency = 1
titleLabel.Text = title
titleLabel.TextColor3 = Theme.Text
bindThemeProperty(titleLabel, loadstring(base64decode("VGV4dA=="))(), loadstring(base64decode("VGV4dENvbG9yMw=="))())
applyFont(titleLabel, Fonts.Bold)
setTextSize(titleLabel, 13)
titleLabel.TextXAlignment = Enum.TextXAlignment.Left
titleLabel.TextTruncate = Enum.TextTruncate.AtEnd
titleLabel.TextYAlignment = Enum.TextYAlignment.Center
titleLabel.Parent = row
local u1 = Instance.new(loadstring(base64decode("VUlUZXh0U2l6ZUNvbnN0cmFpbnQ="))())
u1.MaxTextSize = math.clamp(15 * (UserTextScale or 1), 13, 30)
u1.Parent = titleLabel
if desc then
titleLabel.Position = UDim2.new(0, 42, 0, 10)
titleLabel.Size = UDim2.new(1, -54, 0, 20)
local descLabel = Instance.new(loadstring(base64decode("VGV4dExhYmVs"))())
descLabel.BackgroundTransparency = 1
descLabel.Position = UDim2.new(0, 42, 0, 36)
descLabel.Size = UDim2.new(1, -54, 0, 18)
descLabel.Text = desc
descLabel.TextColor3 = Theme.TextMuted
bindThemeProperty(descLabel, loadstring(base64decode("VGV4dE11dGVk"))(), loadstring(base64decode("VGV4dENvbG9yMw=="))())
applyFont(descLabel, Fonts.Regular)
setTextSize(descLabel, 11)
descLabel.TextXAlignment = Enum.TextXAlignment.Left
descLabel.TextTruncate = Enum.TextTruncate.AtEnd
descLabel.TextYAlignment = Enum.TextYAlignment.Top
descLabel.Parent = row
local u2 = Instance.new(loadstring(base64decode("VUlUZXh0U2l6ZUNvbnN0cmFpbnQ="))())
u2.MaxTextSize = math.clamp(13 * (UserTextScale or 1), 11, 22)
u2.Parent = descLabel
else
titleLabel.Position = UDim2.new(0, 42, 0, 0)
titleLabel.Size = UDim2.new(1, -54, 1, 0)
end
local click = Instance.new(loadstring(base64decode("VGV4dEJ1dHRvbg=="))())
click.Size = UDim2.new(1, 0, 1, 0)
click.BackgroundTransparency = 1
click.Text = loadstring(base64decode(""))()
click.Parent = row
attachRowHover(row, click)
track(click.Activated:Connect(function()
TweenService:Create(click, TweenInfo.new(0.08), { BackgroundTransparency = 0.6 }):Play()
task.delay(0.1, function()
if click and click.Parent then
TweenService:Create(click, TweenInfo.new(0.15), { BackgroundTransparency = 1 }):Play()
end
end)
pcall(callback)
end))
return row
end
function Components.CreateSlider(parent, opts)
opts = opts or {}
local title    = opts.Name or loadstring(base64decode("4LiV4Lix4Lin4LmA4Lil4Li34LmI4Lit4LiZ"))()
local minVal   = tonumber(opts.Min) or 0
local maxVal   = tonumber(opts.Max) or 100
local step     = tonumber(opts.Step) or 1
local default  = tonumber(opts.Default) or minVal
local suffix   = opts.Suffix or loadstring(base64decode(""))()
local callback = opts.Callback or function() end
local iconDraw = opts.Icon or Icons.Slider
local displayFormat = opts.Format or function(v) return tostring(v) .. suffix end
local row = makeRow(parent, loadstring(base64decode("U2xpZGVyXw=="))() .. title, 58, opts.Order)
makeRowIcon(row, iconDraw, 8)
local titleLabel = Instance.new(loadstring(base64decode("VGV4dExhYmVs"))())
titleLabel.BackgroundTransparency = 1
titleLabel.Position = UDim2.new(0, 42, 0, 10)
titleLabel.Size = UDim2.new(1, -140, 0, 18)
titleLabel.Text = title
titleLabel.TextColor3 = Theme.Text
applyFont(titleLabel, Fonts.Medium)
setTextSize(titleLabel, 12)
titleLabel.TextXAlignment = Enum.TextXAlignment.Left
titleLabel.TextTruncate = Enum.TextTruncate.AtEnd
titleLabel.Parent = row
local valueLabel = Instance.new(loadstring(base64decode("VGV4dExhYmVs"))())
valueLabel.BackgroundTransparency = 1
valueLabel.Position = UDim2.new(1, -96, 0, 10)
valueLabel.Size = UDim2.new(0, 86, 0, 18)
valueLabel.Text = displayFormat(default)
valueLabel.TextColor3 = Theme.AccentLight
applyFont(valueLabel, Fonts.Bold)
setTextSize(valueLabel, 12)
valueLabel.TextXAlignment = Enum.TextXAlignment.Right
valueLabel.Parent = row
local trackBg = Instance.new(loadstring(base64decode("RnJhbWU="))())
trackBg.Name = loadstring(base64decode("VHJhY2s="))()
trackBg.Size = UDim2.new(1, -24, 0, 8)
trackBg.Position = UDim2.new(0, 12, 1, -20)
trackBg.BackgroundColor3 = Theme.SwitchOff
trackBg.BorderSizePixel = 0
trackBg.Parent = row
Instance.new(loadstring(base64decode("VUlDb3JuZXI="))(), trackBg).CornerRadius = UDim.new(1, 0)
local fill = Instance.new(loadstring(base64decode("RnJhbWU="))())
fill.Name = loadstring(base64decode("RmlsbA=="))()
fill.Size = UDim2.new(0, 0, 1, 0)
fill.BackgroundColor3 = Theme.Accent
fill.BorderSizePixel = 0
fill.Parent = trackBg
Instance.new(loadstring(base64decode("VUlDb3JuZXI="))(), fill).CornerRadius = UDim.new(1, 0)
local knob = Instance.new(loadstring(base64decode("RnJhbWU="))())
knob.Size = UDim2.fromOffset(14, 14)
knob.AnchorPoint = Vector2.new(0.5, 0.5)
knob.Position = UDim2.new(1, 0, 0.5, 0)
knob.BackgroundColor3 = Theme.White
knob.BorderSizePixel = 0
knob.Parent = fill
Instance.new(loadstring(base64decode("VUlDb3JuZXI="))(), knob).CornerRadius = UDim.new(1, 0)
local clickArea = Instance.new(loadstring(base64decode("VGV4dEJ1dHRvbg=="))())
clickArea.Size = UDim2.new(1, 0, 0, 28)
clickArea.Position = UDim2.new(0, 0, 1, -28)
clickArea.BackgroundTransparency = 1
clickArea.Text = loadstring(base64decode(""))()
clickArea.Parent = row
local currentValue = math.clamp(default, minVal, maxVal)
local dragging = false
local function applyVisual(animate)
local percent = (currentValue - minVal) / math.max(0.0001, maxVal - minVal)
local targetSize = UDim2.new(percent, 0, 1, 0)
if animate then
TweenService:Create(fill, TweenInfo.new(Config.AnimFast), { Size = targetSize }):Play()
else
fill.Size = targetSize
end
valueLabel.Text = displayFormat(currentValue)
end
local function setValueFromX(absX, fire)
local trackPos = trackBg.AbsolutePosition.X
local trackSize = math.max(1, trackBg.AbsoluteSize.X)
local percent = math.clamp((absX - trackPos) / trackSize, 0, 1)
local raw = minVal + percent * (maxVal - minVal)
if step > 0 then raw = math.floor(raw / step + 0.5) * step end
currentValue = math.clamp(raw, minVal, maxVal)
applyVisual(false)
if fire then pcall(callback, currentValue) end
end
applyVisual(false)
track(clickArea.InputBegan:Connect(function(input)
local it = input.UserInputType
if it == Enum.UserInputType.MouseButton1 or it == Enum.UserInputType.Touch then
dragging = true
setValueFromX(input.Position.X, true)
end
end))
track(UserInputService.InputChanged:Connect(function(input)
if not dragging then return end
local it = input.UserInputType
if it == Enum.UserInputType.MouseMovement or it == Enum.UserInputType.Touch then
setValueFromX(input.Position.X, true)
end
end))
track(UserInputService.InputEnded:Connect(function(input)
if not dragging then return end
local it = input.UserInputType
if it == Enum.UserInputType.MouseButton1 or it == Enum.UserInputType.Touch then
dragging = false
end
end))
return row, function() return currentValue end, function(v)
currentValue = math.clamp(tonumber(v) or minVal, minVal, maxVal)
applyVisual(true)
end
end
