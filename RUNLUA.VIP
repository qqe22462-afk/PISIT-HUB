local function loadSettings()
if not hasFileStorage() or not isfile(SETTINGS_FILE) then
if MemorySettings then
applySettingsData(MemorySettings)
return true, loadstring(base64decode("4Lir4LiZ4LmI4Lin4Lii4LiE4Lin4Liy4Lih4LiI4Liz"))()
end
return false, loadstring(base64decode("4Lii4Lix4LiH4LmE4Lih4LmI4Lie4Lia4LmE4Lif4Lil4LmM4LiB4Liy4Lij4LiV4Lix4LmJ4LiH4LiE4LmI4Liy"))()
end
local okRead, raw = pcall(function() return readfile(SETTINGS_FILE) end)
if not okRead or type(raw) ~= loadstring(base64decode("c3RyaW5n"))() or raw == loadstring(base64decode(""))() then
return false, loadstring(base64decode("4Lit4LmI4Liy4LiZ4LmE4Lif4Lil4LmM4LiB4Liy4Lij4LiV4Lix4LmJ4LiH4LiE4LmI4Liy4LmE4Lih4LmI4Liq4Liz4LmA4Lij4LmH4LiI"))()
end
local okDecode, data = pcall(function() return HttpService:JSONDecode(raw) end)
if not okDecode or type(data) ~= loadstring(base64decode("dGFibGU="))() then
return false, loadstring(base64decode("4LmE4Lif4Lil4LmM4LiB4Liy4Lij4LiV4Lix4LmJ4LiH4LiE4LmI4Liy4Lih4Li14Lij4Li54Lib4LmB4Lia4Lia4LmE4Lih4LmI4LiW4Li54LiB4LiV4LmJ4Lit4LiH"))()
end
if not applySettingsData(data) then return false, loadstring(base64decode("4LmD4LiK4LmJ4LiC4LmJ4Lit4Lih4Li54Lil4LiB4Liy4Lij4LiV4Lix4LmJ4LiH4LiE4LmI4Liy4LmE4Lih4LmI4Liq4Liz4LmA4Lij4LmH4LiI"))() end
MemorySettings = data
LastLoadedFromFile = true
return true, SETTINGS_FILE
end
local function resetSettings()
UserScale = 1.0
UserTextScale = DefaultConfig.TextScale
UserFontWeight = DefaultConfig.FontWeight
for k, v in pairs(DefaultTheme) do Theme[k] = v end
applySettingsVisuals()
return true
end
local function AddGradient(parent, rotation, c1, c2)
local g = Instance.new(loadstring(base64decode("VUlHcmFkaWVudA=="))())
g.Color = ColorSequence.new({
ColorSequenceKeypoint.new(0, c1 or Theme.IconGradStart),
ColorSequenceKeypoint.new(1, c2 or Theme.IconGradEnd),
})
g.Rotation = rotation or Theme.IconGradAngle
g.Parent = parent
return g
end
local Icons = {}
local function makeIconImage(parent, iconId, color, size, useGradient)
local img = Instance.new(loadstring(base64decode("SW1hZ2VMYWJlbA=="))())
img.Name = loadstring(base64decode("SWNvbg=="))()
img.Size = UDim2.fromOffset(size or 16, size or 16)
img.AnchorPoint = Vector2.new(0.5, 0.5)
img.Position = UDim2.fromScale(0.5, 0.5)
img.BackgroundTransparency = 1
img.ScaleType = Enum.ScaleType.Fit
if useGradient ~= false then
img.ImageColor3 = Color3.fromRGB(255, 255, 255)
AddGradient(img, Theme.IconGradAngle, Theme.IconGradStart, Theme.IconGradEnd)
img:SetAttribute(loadstring(base64decode("SGFzR3JhZGllbnQ="))(), true)
else
img.ImageColor3 = color or Theme.TextMuted
img:SetAttribute(loadstring(base64decode("SGFzR3JhZGllbnQ="))(), false)
end
img.Parent = parent
RegIcon(img, iconId)
return img
end
