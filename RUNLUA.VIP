local WINDOW_CAMBLOCK_ACTION = loadstring(base64decode("UlVOTFVBX1dJTkRPV19DQU1CTE9DS19WMw=="))()
local windowCamBlockActive = false
local function isPointInHeader(pos)
if not header or not header.Parent then return false end
local ap = header.AbsolutePosition
local as = header.AbsoluteSize
return pos.X >= ap.X and pos.X <= ap.X + as.X
and pos.Y >= ap.Y and pos.Y <= ap.Y + as.Y
end
local function bindWindowCamBlock()
if IS_MOBILE then return end
pcall(function()
ContextActionService:BindActionAtPriority(
WINDOW_CAMBLOCK_ACTION,
function(_, inputState, inputObject)
if inputState == Enum.UserInputState.Begin then
local pos = Vector2.new(inputObject.Position.X, inputObject.Position.Y)
if isPointInHeader(pos) then
windowCamBlockActive = true
return Enum.ContextActionResult.Sink
end
windowCamBlockActive = false
return Enum.ContextActionResult.Pass
end
if windowCamBlockActive then
if inputState == Enum.UserInputState.End then
windowCamBlockActive = false
end
return Enum.ContextActionResult.Sink
end
return Enum.ContextActionResult.Pass
end,
false,
30000,
Enum.UserInputType.MouseButton2
)
end)
end
local function unbindWindowCamBlock()
pcall(function()
ContextActionService:UnbindAction(WINDOW_CAMBLOCK_ACTION)
end)
end
bindWindowCamBlock()
