local function createColorSwatches(parent, title, colors, selectedColor, onPick, order)
local section = Components.CreateSection(parent, {Title = title, Order = order})
local grid = Instance.new(loadstring(base64decode("RnJhbWU="))())
grid.Name = loadstring(base64decode("Q29sb3JTd2F0Y2hlcw=="))()
grid.BackgroundTransparency = 1
grid.Size = UDim2.new(1, 0, 0, 82)
grid.LayoutOrder = 1
grid.Parent = section
local gridLayout = Instance.new(loadstring(base64decode("VUlHcmlkTGF5b3V0"))())
gridLayout.CellSize = UDim2.fromOffset(42, 32)
gridLayout.CellPadding = UDim2.fromOffset(10, 10)
gridLayout.FillDirectionMaxCells = 6
gridLayout.SortOrder = Enum.SortOrder.LayoutOrder
gridLayout.Parent = grid
for index, item in ipairs(colors) do
local swatch = Instance.new(loadstring(base64decode("VGV4dEJ1dHRvbg=="))())
swatch.Name = loadstring(base64decode("U3dhdGNoXw=="))() .. tostring(index)
swatch.LayoutOrder = index
swatch.Size = UDim2.fromOffset(42, 32)
swatch.BackgroundColor3 = item.Color
swatch.BorderSizePixel = 0
swatch.Text = loadstring(base64decode(""))()
swatch.AutoButtonColor = false
swatch.Parent = grid
Instance.new(loadstring(base64decode("VUlDb3JuZXI="))(), swatch).CornerRadius = UDim.new(0, 7)
local stroke = Instance.new(loadstring(base64decode("VUlTdHJva2U="))())
stroke.Color = colorsEqual(item.Color, selectedColor) and Theme.White or Theme.Border
stroke.Thickness = colorsEqual(item.Color, selectedColor) and 2 or 1
stroke.Transparency = colorsEqual(item.Color, selectedColor) and 0 or 0.25
stroke.Parent = swatch
local tick = Instance.new(loadstring(base64decode("VGV4dExhYmVs"))())
tick.BackgroundTransparency = 1
tick.Size = UDim2.fromScale(1, 1)
tick.Text = colorsEqual(item.Color, selectedColor) and loadstring(base64decode("4pyT"))() or loadstring(base64decode(""))()
tick.TextColor3 = Theme.White
tick.Font = Enum.Font.GothamBold
tick.TextSize = 16
tick.Parent = swatch
track(swatch.Activated:Connect(function()
selectedColor = item.Color
for _, child in ipairs(grid:GetChildren()) do
if child:IsA(loadstring(base64decode("VGV4dEJ1dHRvbg=="))()) then
local st = child:FindFirstChildOfClass(loadstring(base64decode("VUlTdHJva2U="))())
local label = child:FindFirstChildOfClass(loadstring(base64decode("VGV4dExhYmVs"))())
local isSelected = child == swatch
if st then st.Color = isSelected and Theme.White or Theme.Border; st.Thickness = isSelected and 2 or 1; st.Transparency = isSelected and 0 or 0.25 end
if label then label.Text = isSelected and loadstring(base64decode("4pyT"))() or loadstring(base64decode(""))() end
end
end
onPick(item.Color, item.Name)
end))
end
return section
end
