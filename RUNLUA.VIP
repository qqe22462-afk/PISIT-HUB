function Components.CreateSection(parent, opts)
opts = opts or {}
local section = Instance.new(loadstring(base64decode("RnJhbWU="))())
section.Name = opts.Name or loadstring(base64decode("U2VjdGlvbg=="))()
section.BackgroundTransparency = 1
section.Size = UDim2.new(1, 0, 0, 0)
section.AutomaticSize = Enum.AutomaticSize.Y
section.LayoutOrder = opts.Order or 0
section.Parent = parent
local layout = Instance.new(loadstring(base64decode("VUlMaXN0TGF5b3V0"))())
layout.SortOrder = Enum.SortOrder.LayoutOrder
layout.Padding = UDim.new(0, Config.RowSpacing)
layout.Parent = section
if opts.Title then
local title = Instance.new(loadstring(base64decode("VGV4dExhYmVs"))())
title.Size = UDim2.new(1, 0, 0, 26)
title.BackgroundTransparency = 1
title.Text = opts.Title
title.TextColor3 = Theme.TextMuted
setTextSize(title, 11)
applyFont(title, Fonts.Bold)
title.TextXAlignment = Enum.TextXAlignment.Left
title.TextYAlignment = Enum.TextYAlignment.Bottom
title.LayoutOrder = -100
title.Parent = section
local u = Instance.new(loadstring(base64decode("VUlUZXh0U2l6ZUNvbnN0cmFpbnQ="))())
u.MaxTextSize = math.clamp(13 * (UserTextScale or 1), 12, 24)
u.Parent = title
end
return section
end
local rowCount = 0
local function nextOrder()
rowCount = rowCount + 1
return rowCount
end
local function makeRow(parent, name, height, order)
local row = Instance.new(loadstring(base64decode("RnJhbWU="))())
row.Name = name
row.Size = UDim2.new(1, 0, 0, height)
row.BackgroundColor3 = Theme.Surface
bindThemeObject(row, loadstring(base64decode("U3VyZmFjZQ=="))())
row.BorderSizePixel = 0
row.LayoutOrder = order or nextOrder()
row.Parent = parent
Instance.new(loadstring(base64decode("VUlDb3JuZXI="))(), row).CornerRadius = UDim.new(0, 7)
local stroke = Instance.new(loadstring(base64decode("VUlTdHJva2U="))())
stroke.Color = Theme.Border
bindThemeProperty(stroke, loadstring(base64decode("Qm9yZGVy"))(), loadstring(base64decode("Q29sb3I="))())
stroke.Thickness = 1
stroke.Transparency = 0.5
stroke.Parent = row
return row, stroke
end
