local function tintIconHolder(holder, color, isActive)
for _, child in ipairs(holder:GetDescendants()) do
if child:IsA(loadstring(base64decode("RnJhbWU="))()) then
child.BackgroundColor3 = color
elseif child:IsA(loadstring(base64decode("SW1hZ2VMYWJlbA=="))()) then
if child:GetAttribute(loadstring(base64decode("SGFzR3JhZGllbnQ="))()) then
child.ImageColor3 = (isActive == false)
and Theme.IconDim or Color3.fromRGB(255, 255, 255)
else
child.ImageColor3 = color
end
end
end
end
