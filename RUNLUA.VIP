bindThemeProperty(line, loadstring(base64decode("Qm9yZGVy"))(), loadstring(base64decode("QmFja2dyb3VuZENvbG9yMw=="))())
line.BorderSizePixel = 0
line.BackgroundTransparency = 0.25
line.Parent = sep
end
table.insert(Tabs, tab)
track(btn.MouseEnter:Connect(function()
if activeTab ~= tab and not IS_MOBILE then
local hoverColor = tab.IsSettings and Theme.SurfaceHover or Theme.SurfaceHover
TweenService:Create(btn, TweenInfo.new(Config.AnimFast), { BackgroundColor3 = hoverColor }):Play()
end
end))
track(btn.MouseLeave:Connect(function()
if activeTab ~= tab and not IS_MOBILE then
TweenService:Create(btn, TweenInfo.new(Config.AnimFast), { BackgroundColor3 = tab.IsSettings and Theme.Background or Theme.SurfaceAlt }):Play()
end
end))
track(btn.Activated:Connect(function()
selectTab(tab)
end))
if tab.IsSettings then
if #Tabs == 1 and not activeTab then selectTab(tab) end
elseif (not activeTab) or (activeTab and activeTab.IsSettings and thisIndex == 2) then
selectTab(tab)
end
return tab
end
local SettingsTab = CreateTab({
