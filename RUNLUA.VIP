local function selectTab(tab)
if not tab or activeTab == tab then return end
for _, t in ipairs(Tabs) do
if t.Page then t.Page.Visible = (t == tab) end
local btn, ind, lbl, iconHolder = t.Button, t.Indicator, t.Label, t.IconHolder
if t == tab then
btn:SetAttribute(loadstring(base64decode("UlVOTFVBX1NFTEVDVEVE"))(), true)
if btn:GetAttribute(loadstring(base64decode("UlVOTFVBX0lTX1NFVFRJTkdT"))()) then
bindThemeObject(btn, loadstring(base64decode("U2V0dGluZ3NCdXR0b24="))())
TweenService:Create(btn, TweenInfo.new(Config.AnimFast), { BackgroundColor3 = Theme.AccentSoft }):Play()
else
bindThemeObject(btn, loadstring(base64decode("VGFiQnV0dG9u"))())
TweenService:Create(btn, TweenInfo.new(Config.AnimFast), { BackgroundColor3 = Theme.Accent }):Play()
end
TweenService:Create(ind, TweenInfo.new(Config.AnimFast), { BackgroundTransparency = 0 }):Play()
lbl.TextColor3 = Theme.White
tintIconHolder(iconHolder, Theme.White, true)
else
btn:SetAttribute(loadstring(base64decode("UlVOTFVBX1NFTEVDVEVE"))(), false)
if btn:GetAttribute(loadstring(base64decode("UlVOTFVBX0lTX1NFVFRJTkdT"))()) then
bindThemeObject(btn, loadstring(base64decode("U2V0dGluZ3NCdXR0b24="))())
else
bindThemeObject(btn, loadstring(base64decode("VGFiQnV0dG9u"))())
end
TweenService:Create(btn, TweenInfo.new(Config.AnimFast), { BackgroundColor3 = btn:GetAttribute(loadstring(base64decode("UlVOTFVBX0lTX1NFVFRJTkdT"))()) and Theme.Background or Theme.SurfaceAlt }):Play()
TweenService:Create(ind, TweenInfo.new(Config.AnimFast), { BackgroundTransparency = 1 }):Play()
lbl.TextColor3 = Theme.TextMuted
tintIconHolder(iconHolder, Theme.TextMuted, false)
end
end
activeTab = tab
end
local function CreateTab(opts)
opts = opts or {}
local name = opts.Name or loadstring(base64decode("4LmB4LiX4LmH4Lia"))()
local iconDraw = opts.Icon or Icons.Home
tabCounter = tabCounter + 1
local thisIndex = tabCounter
local page = Instance.new(loadstring(base64decode("U2Nyb2xsaW5nRnJhbWU="))())
page.Name = name .. loadstring(base64decode("UGFnZQ=="))()
