if player ~= LocalPlayer then
local card = Instance.new(loadstring(base64decode("RnJhbWU="))())
card.Name = loadstring(base64decode("Q2FyZF8="))() .. player.Name
card.Size = UDim2.new(1, -5, 0, 72)
