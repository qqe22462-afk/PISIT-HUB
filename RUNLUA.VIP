TweenService:Create(optionBtn, TweenInfo.new(Config.AnimFast), { BackgroundColor3 = Theme.SurfaceHover }):Play()
end))
track(optionBtn.MouseLeave:Connect(function()
TweenService:Create(optionBtn, TweenInfo.new(Config.AnimFast), { BackgroundColor3 = Theme.SurfaceAlt }):Play()
end))
track(optionBtn.Activated:Connect(function()
current = opt
valueLabel.Text = tostring(opt)
collapse()
pcall(callback, opt)
end))
end
