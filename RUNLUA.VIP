local settingsState = {
textScaleSetter = nil,
weightSetter = nil,
accentInputSetter = nil,
backgroundInputSetter = nil,
statusLabel = nil,
}
local function updateSettingsStatus(text, color)
if settingsState.statusLabel and settingsState.statusLabel.Parent then
settingsState.statusLabel.Text = text
settingsState.statusLabel.TextColor3 = color or Theme.TextMuted
end
end
local function refreshSettingsControls()
if settingsState.textScaleSetter then
local scale = tonumber(UserTextScale) or 1.30
local preset = (math.abs(scale - 1.00) < math.abs(scale - 1.30) and math.abs(scale - 1.00) < math.abs(scale - 1.45)) and loadstring(base64decode("4Lie4Lit4LiU4Li1"))()
or ((math.abs(scale - 1.45) < math.abs(scale - 1.30)) and loadstring(base64decode("4LmD4Lir4LiN4LmI"))() or loadstring(base64decode("4LiB4Lil4Liy4LiH"))())
pcall(settingsState.textScaleSetter, preset)
end
if settingsState.weightSetter then pcall(settingsState.weightSetter, UserFontWeight) end
end
local settingsGeneral = Components.CreateSection(SettingsTab.Page, {
Title = loadstring(base64decode("4Lij4Li54Lib4Lil4Lix4LiB4Lip4LiT4LmM4Lir4Lil4Lix4LiB"))(),
Order = 1,
})
local textSizePresets = {
[loadstring(base64decode("4Lie4Lit4LiU4Li1"))()] = 1.00,
[loadstring(base64decode("4LiB4Lil4Liy4LiH"))()] = 1.30,
[loadstring(base64decode("4LmD4Lir4LiN4LmI"))()] = 1.45,
}
local function getTextSizePreset()
local bestName, bestDiff = loadstring(base64decode("4LiB4Lil4Liy4LiH"))(), math.huge
for name, value in pairs(textSizePresets) do
local diff = math.abs((tonumber(UserTextScale) or 1.30) - value)
if diff < bestDiff then bestName, bestDiff = name, diff end
end
return bestName
end
