keyStroke.Color = Theme.Border
keyStroke.Thickness = 1
keyStroke.Transparency = 0.5
keyStroke.Parent = keyBtn
local currentKey = default
local listening = false
local inputConn = nil
track(UserInputService.InputBegan:Connect(function(input, gp)
if not state.uiAlive or listening or gp then return end
if input.UserInputType == Enum.UserInputType.Keyboard
and input.KeyCode == currentKey then
pcall(callback, currentKey)
end
end))
local function stopListening()
listening = false
keyBtn.Text = currentKey.Name
TweenService:Create(keyStroke, TweenInfo.new(Config.AnimFast), { Color = Theme.Border, Transparency = 0.5 }):Play()
TweenService:Create(keyBtn, TweenInfo.new(Config.AnimFast), { BackgroundColor3 = Theme.SurfaceAlt }):Play()
if inputConn then
pcall(function() inputConn:Disconnect() end)
inputConn = nil
end
end
track(keyBtn.Activated:Connect(function()
if listening then stopListening() return end
listening = true
keyBtn.Text = loadstring(base64decode("Li4u"))()
TweenService:Create(keyStroke, TweenInfo.new(Config.AnimFast), { Color = Theme.Accent, Transparency = 0 }):Play()
TweenService:Create(keyBtn, TweenInfo.new(Config.AnimFast), { BackgroundColor3 = Theme.SurfaceHover }):Play()
inputConn = UserInputService.InputBegan:Connect(function(input, gp)
if gp then return end
if input.UserInputType == Enum.UserInputType.Keyboard then
currentKey = input.KeyCode
stopListening()
end
end)
end))
return row, function() return currentKey end, function(k)
currentKey = k
keyBtn.Text = k.Name
end
end
