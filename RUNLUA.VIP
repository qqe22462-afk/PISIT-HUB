healthFill.Name = loadstring(base64decode("SGVhbHRoRmlsbA=="))()
healthFill.Size = UDim2.fromScale(0, 1)
healthFill.BackgroundColor3 = Theme.Success
healthFill.BorderSizePixel = 0
healthFill.Parent = healthTrack
Instance.new(loadstring(base64decode("VUlDb3JuZXI="))(), healthFill).CornerRadius = UDim.new(1, 0)
local function refreshPlayerHealth()
if not playerHealthText.Parent then return end
local character = player.Character
local hum = character and character:FindFirstChildOfClass(loadstring(base64decode("SHVtYW5vaWQ="))())
if not hum then
playerHealthText.Text = loadstring(base64decode("4LmA4Lil4Li34Lit4LiUIC0tIC8gLS0="))()
healthFill.Size = UDim2.fromScale(0, 1)
return
end
local maxHealth = math.max(hum.MaxHealth, 1)
local health = math.clamp(hum.Health, 0, maxHealth)
local ratio = math.clamp(health / maxHealth, 0, 1)
playerHealthText.Text = string.format(loadstring(base64decode("4LmA4Lil4Li34Lit4LiUICVkIC8gJWQ="))(), math.floor(health + 0.5), math.floor(maxHealth + 0.5))
healthFill.Size = UDim2.new(ratio, 0, 1, 0)
healthFill.BackgroundColor3 = ratio > 0.5 and Theme.Success or (ratio > 0.2 and Theme.Warning or Theme.Danger)
end
task.spawn(function()
local hum = player.Character and player.Character:FindFirstChildOfClass(loadstring(base64decode("SHVtYW5vaWQ="))())
if not hum and player.Character then
pcall(function() hum = player.Character:WaitForChild(loadstring(base64decode("SHVtYW5vaWQ="))(), 5) end)
end
if hum and playerHealthText.Parent then
table.insert(cardConnections, hum.HealthChanged:Connect(refreshPlayerHealth))
end
refreshPlayerHealth()
end)
table.insert(cardConnections, player.CharacterAdded:Connect(function(character)
task.spawn(function()
local hum = character:FindFirstChildOfClass(loadstring(base64decode("SHVtYW5vaWQ="))())
if not hum then
pcall(function() hum = character:WaitForChild(loadstring(base64decode("SHVtYW5vaWQ="))(), 5) end)
end
if hum and playerHealthText.Parent then
table.insert(cardConnections, hum.HealthChanged:Connect(refreshPlayerHealth))
end
refreshPlayerHealth()
end)
end))
local click = Instance.new(loadstring(base64decode("VGV4dEJ1dHRvbg=="))())
click.Size = UDim2.new(1, 0, 1, 0)
click.BackgroundTransparency = 1
click.Text = loadstring(base64decode(""))()
click.Parent = card
local conn = click.Activated:Connect(function()
if not card.Parent then return end
selectedPlayer = player
for _, c in ipairs(scroll:GetChildren()) do
if c:IsA(loadstring(base64decode("RnJhbWU="))()) then c.BackgroundColor3 = Theme.SurfaceAlt end
end
if card.Parent then card.BackgroundColor3 = accentColor end
pcall(onSelect, player)
end)
table.insert(cardConnections, conn)
end
end
end
rebuild()
return wrapper, rebuild, function() return selectedPlayer end
end
