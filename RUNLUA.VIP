click.BackgroundTransparency = 1
click.Text = loadstring(base64decode(""))()
click.Parent = row
attachRowHover(row, click)
track(click.Activated:Connect(function()
if expanded then collapse() else expand() end
end))
return wrapper, function() return current end, function(v)
current = v
valueLabel.Text = tostring(v)
end
end
