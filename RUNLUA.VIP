local IconRegistry = {}
local function RegisterUrl(numId, cid)
if IconRegistry[numId] then return IconRegistry[numId] end
local rec = { url = nil, images = {}, loading = true }
IconRegistry[numId] = rec
task.spawn(function()
local url = ResolveAssetUrl(cid)
if not url or url == loadstring(base64decode(""))() then url = FallbackUrl(cid) end
rec.url = url
rec.loading = false
for _, img in ipairs(rec.images) do SafeImage(img, url) end
end)
return rec
end
local function RegIcon(imageLabel, id)
if not imageLabel or not id then return end
local cid = tostring(id):match(loadstring(base64decode("JWQr"))())
if not cid then return end
local numId = tonumber(cid) or cid
SafeImage(imageLabel, FallbackUrl(cid))
local rec = IconRegistry[numId] or RegisterUrl(numId, cid)
table.insert(rec.images, imageLabel)
if rec.url and not rec.loading then SafeImage(imageLabel, rec.url) end
end
