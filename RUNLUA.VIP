local function ResolveAssetUrl(cid)
if not RunService:IsStudio() then return nil end
local url
pcall(function()
local objs = game:GetObjects(loadstring(base64decode("cmJ4YXNzZXRpZDovLw=="))() .. cid)
if objs and #objs > 0 then
local o = objs[1]
if o:IsA(loadstring(base64decode("RGVjYWw="))()) or o:IsA(loadstring(base64decode("VGV4dHVyZQ=="))()) then url = o.Texture
elseif o:IsA(loadstring(base64decode("SW1hZ2VMYWJlbA=="))()) or o:IsA(loadstring(base64decode("SW1hZ2VCdXR0b24="))()) then url = o.Image
else
local d = o:FindFirstChildWhichIsA(loadstring(base64decode("RGVjYWw="))(), true)
or o:FindFirstChildWhichIsA(loadstring(base64decode("VGV4dHVyZQ=="))(), true)
if d then url = d.Texture end
end
pcall(function() o:Destroy() end)
end
end)
return url
end
